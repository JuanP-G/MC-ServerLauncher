<Project Sdk="Microsoft.NET.Sdk">
  <!-- Records the promo's footage: the real views, driven by simulated mouse and keyboard, with made-up
       servers. Not part of the solution; see promo/README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS8321;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\McServerLauncher\McServerLauncher.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="11.2.3" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="11.2.3" />
  </ItemGroup>
</Project>
