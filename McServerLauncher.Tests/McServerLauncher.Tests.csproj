<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- The picker bug that shipped twice - the selection being one behind inside its own event -
         is only visible with real Avalonia controls running. Headless gives that without a display,
         so it runs on the Linux CI leg too. -->
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\McServerLauncher\McServerLauncher.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Written by tools/store-catalog itself, so a test can say the app reads what the pipeline writes. -->
    <None Update="Fixtures\store-catalog.sample.json.gz" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
