<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:McServerLauncher.Controls">

    <!-- Todo el movimiento de la app, en un sitio.

         Criterio: sutil y corto. Nada rebota, nada pasa de 180 ms, y nada se mueve por moverse:
         cada transicion dice algo (esto se puede pulsar, esto ha cambiado, esto acaba de aparecer).
         La unica excepcion es el aviso de «+ Nuevo», que se explica en su seccion.
         Que viva solo aqui es lo que permite revisarlo de un vistazo, y un test comprueba que ninguna
         vista declara movimiento por su cuenta. -->

    <!-- ===================== BOTONES =====================
         El fondo cambia con suavidad al pasar el raton, y al pulsar el boton se hunde un poco. -->
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button">
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>

    <!-- ===================== LISTAS =====================
         Las filas se iluminan al pasar el raton en vez de cambiar de golpe. -->
    <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Las acciones de cada fila de servidor: invisibles hasta que la fila tiene el raton encima o
         esta seleccionada, y mientras no se ven tampoco se pueden pulsar. -->
    <Style Selector="StackPanel.rowactions">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover StackPanel.rowactions, ListBoxItem:selected StackPanel.rowactions">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <Style Selector="Button.rowaction">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Button.rowaction.danger:pointerover">
        <Setter Property="Foreground" Value="{StaticResource DangerIcon}" />
    </Style>

    <!-- ===================== «+ NUEVO» =====================
         Su recordatorio, cada 25 s: un destello cruza el boton (el primer segundo) y, al salir por
         el otro lado, se convierte en un halo que se abre desde el borde y se apaga (el segundo).
         Cuando suena lo decide Behaviors/BeaconBehavior, que pone .beacon-a o .beacon-b por turnos y
         calla con el raton encima o con el panel de nuevo servidor abierto; aqui solo esta como se ve.

         El halo es el azul de AccentSelected (58A6FF) con su opacidad, escrito aqui porque una sombra
         no admite fichas. Los porcentajes, enteros, y sin KeySpline: Avalonia lee los dos con el
         idioma del sistema, y en español (coma decimal) no entiende ni "96.4%" ni "0.45,0,0.25,1" y
         la animacion se queda quieta sin avisar. La curva va dibujada a mano, un fotograma cada 10 %:
         el destello arranca despacio, cruza deprisa y frena al salir; el halo se abre rapido y se
         apaga despacio. Un test vigila que no vuelva ningun decimal. -->
    <Style Selector="Panel.newserver.beacon-a:not(:pointerover) Border.shine">
        <Style.Animations>
            <Animation Duration="0:0:2">
                <KeyFrame Cue="0%">
                    <Setter Property="TranslateTransform.X" Value="-40" />
                </KeyFrame>
                <KeyFrame Cue="10%">
                    <Setter Property="TranslateTransform.X" Value="-32" />
                </KeyFrame>
                <KeyFrame Cue="20%">
                    <Setter Property="TranslateTransform.X" Value="-8" />
                </KeyFrame>
                <KeyFrame Cue="30%">
                    <Setter Property="TranslateTransform.X" Value="40" />
                </KeyFrame>
                <KeyFrame Cue="40%">
                    <Setter Property="TranslateTransform.X" Value="100" />
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="TranslateTransform.X" Value="130" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="TranslateTransform.X" Value="130" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Panel.newserver.beacon-a:not(:pointerover) Border.halo">
        <Style.Animations>
            <Animation Duration="0:0:2">
                <KeyFrame Cue="0%">
                    <Setter Property="BoxShadow" Value="0 0 0 0 #0058A6FF" />
                </KeyFrame>
                <KeyFrame Cue="49%">
                    <Setter Property="BoxShadow" Value="0 0 0 0 #0058A6FF" />
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="BoxShadow" Value="0 0 0 0 #9958A6FF" />
                </KeyFrame>
                <KeyFrame Cue="60%">
                    <Setter Property="BoxShadow" Value="0 0 0 4.5 #6658A6FF" />
                </KeyFrame>
                <KeyFrame Cue="70%">
                    <Setter Property="BoxShadow" Value="0 0 0 6.5 #3858A6FF" />
                </KeyFrame>
                <KeyFrame Cue="80%">
                    <Setter Property="BoxShadow" Value="0 0 0 7.5 #1858A6FF" />
                </KeyFrame>
                <KeyFrame Cue="90%">
                    <Setter Property="BoxShadow" Value="0 0 0 7.9 #0858A6FF" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="BoxShadow" Value="0 0 0 8 #0058A6FF" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Panel.newserver.beacon-b:not(:pointerover) Border.shine">
        <Style.Animations>
            <Animation Duration="0:0:2">
                <KeyFrame Cue="0%">
                    <Setter Property="TranslateTransform.X" Value="-40" />
                </KeyFrame>
                <KeyFrame Cue="10%">
                    <Setter Property="TranslateTransform.X" Value="-32" />
                </KeyFrame>
                <KeyFrame Cue="20%">
                    <Setter Property="TranslateTransform.X" Value="-8" />
                </KeyFrame>
                <KeyFrame Cue="30%">
                    <Setter Property="TranslateTransform.X" Value="40" />
                </KeyFrame>
                <KeyFrame Cue="40%">
                    <Setter Property="TranslateTransform.X" Value="100" />
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="TranslateTransform.X" Value="130" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="TranslateTransform.X" Value="130" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Panel.newserver.beacon-b:not(:pointerover) Border.halo">
        <Style.Animations>
            <Animation Duration="0:0:2">
                <KeyFrame Cue="0%">
                    <Setter Property="BoxShadow" Value="0 0 0 0 #0058A6FF" />
                </KeyFrame>
                <KeyFrame Cue="49%">
                    <Setter Property="BoxShadow" Value="0 0 0 0 #0058A6FF" />
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="BoxShadow" Value="0 0 0 0 #9958A6FF" />
                </KeyFrame>
                <KeyFrame Cue="60%">
                    <Setter Property="BoxShadow" Value="0 0 0 4.5 #6658A6FF" />
                </KeyFrame>
                <KeyFrame Cue="70%">
                    <Setter Property="BoxShadow" Value="0 0 0 6.5 #3858A6FF" />
                </KeyFrame>
                <KeyFrame Cue="80%">
                    <Setter Property="BoxShadow" Value="0 0 0 7.5 #1858A6FF" />
                </KeyFrame>
                <KeyFrame Cue="90%">
                    <Setter Property="BoxShadow" Value="0 0 0 7.9 #0858A6FF" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="BoxShadow" Value="0 0 0 8 #0058A6FF" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ===================== PESTAÑAS =====================
         Una sola linea para toda la tira (Controls/TabUnderline) que viaja hasta la pestaña elegida,
         en lugar de una por pestaña que se enciende y se apaga. El titulo cambia de color con
         suavidad, y la pagina que entra lo hace con un fundido. -->
    <Style Selector="TabControl.sliding TabItem /template/ Border#PART_SelectedPipe">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="controls|TabUnderline Border.underline">
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                <DoubleTransition Property="Width" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="TabItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>
    <!-- Dos clases que se alternan, porque una animacion de estilo solo arranca cuando su selector
         empieza a coincidir: con una sola, solo se veria la primera vez. -->
    <Style Selector="ContentPresenter.pagein-a">
        <Style.Animations>
            <Animation Duration="0:0:0.18" Easing="CubicEaseOut" FillMode="Backward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="ContentPresenter.pagein-b">
        <Style.Animations>
            <Animation Duration="0:0:0.18" Easing="CubicEaseOut" FillMode="Backward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ===================== NUEVO SERVIDOR =====================
         Las tarjetas del primer paso: un clic y adelante. El fondo y el borde ya se funden como en
         cualquier boton; ademas la flecha se adelanta un poco al pasar el raton, que es lo que dice
         "esto te lleva a algun sitio". -->
    <Style Selector="Button.origin :is(Control).go">
        <Setter Property="RenderTransform" Value="translateX(0px)" />
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.origin:pointerover :is(Control).go">
        <Setter Property="RenderTransform" Value="translateX(5px)" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- ===================== RAIL =====================  -->
    <Style Selector="Button.rail">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09" />
            </Transitions>
        </Setter>
    </Style>

    <!-- ===================== ICONO DE LA TARJETA =====================
         El velo de "Editar" sobre el icono aparece con un fundido. -->
    <Style Selector="Button.iconbtn Border#HoverOverlay">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.iconbtn:pointerover Border#HoverOverlay">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- ===================== ENTRADAS =====================
         Una seccion, una pagina de Ajustes o un paso del asistente entran con un fundido corto cada
         vez que se hacen visibles. El selector de IsVisible es lo que hace que se repita en cada
         aparicion y no solo la primera vez. -->
    <Style Selector=":is(Control).fadein[IsVisible=True]">
        <Style.Animations>
            <Animation Duration="0:0:0.18" Easing="CubicEaseOut" FillMode="Backward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
</Styles>
