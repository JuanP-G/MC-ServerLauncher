<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The styles more than one view needs, in one place.

         They used to live inside each view's own <Window.Styles>, and that hid two things.

         The first: MainWindow's `Border.stat` and ServerConfigDialog's `Border.card` were the same
         style, value for value, under two names.

         The second is the one that matters, because it is a trap. `Border.card` meant TWO different
         things: in ServerConfigDialog it was this translucent card, and in ServerModsView it was a
         solid dark tile (#1A1A1A, radius 6) in a list. While each style lived inside its own view
         Avalonia kept them apart and nobody noticed. Lifted up here they would have collided in
         silence, and one of the two views would have changed how it looks with nothing failing and
         nothing warning. That is why the tile is now called `Border.tile`: it is a different thing,
         and it finally has a different name. -->

    <!-- The card: the app's standard container. -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource SurfaceCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource SurfaceEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- The same card, with the margin and padding the main window's stat cards use. Only the
         spacing differs: the look is the one above, not a copy of it. -->
    <Style Selector="Border.card.stat">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="4" />
    </Style>

    <!-- Text inside a card: the small dimmed label, and the big number. -->
    <Style Selector="TextBlock.statLabel">
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.statValue">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- A share of a total, as a thin bar: "stone, 62% of everything you have mined". Determinate,
         unlike every other ProgressBar in the app, which are spinners. -->
    <Style Selector="ProgressBar.share">
        <Setter Property="Height" Value="5" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Background" Value="{StaticResource SurfaceChip}" />
        <Setter Property="Foreground" Value="{StaticResource AccentSelected}" />
    </Style>

    <!-- The title and the description of a settings row. -->
    <Style Selector="TextBlock.title">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBlock.desc">
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="2,14,0,8" />
    </Style>

</Styles>
