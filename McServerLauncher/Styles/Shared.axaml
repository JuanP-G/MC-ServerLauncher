<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Los estilos que más de una vista necesita, en un sitio.

         Antes vivían dentro del <Window.Styles> de cada vista, y eso escondía dos cosas.

         La primera: `Border.stat` de MainWindow y `Border.card` de ServerConfigDialog eran el mismo
         estilo, valor por valor, con dos nombres.

         La segunda es la que importa, porque es una trampa. `Border.card` significaba DOS cosas
         distintas: en ServerConfigDialog era esta tarjeta translúcida, y en ServerModsView era un
         azulejo sólido y oscuro (#1A1A1A, radio 6) de una lista. Mientras cada estilo vivía dentro
         de su vista, Avalonia los mantenía separados y nadie se enteraba. Al subirlos aquí habrían
         chocado en silencio y una de las dos vistas habría cambiado de aspecto sin que nada fallara
         ni avisara. Por eso el azulejo se llama ahora `Border.tile`: es otra cosa, y ya tiene otro
         nombre. -->

    <!-- La tarjeta: el contenedor estándar de la app. -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource SurfaceCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource SurfaceEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Misma tarjeta, con el margen y el relleno que usan las de estadísticas de la ventana
         principal. Solo cambia el espaciado: el aspecto es el de arriba, no una copia de él. -->
    <Style Selector="Border.card.stat">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="4" />
    </Style>

    <!-- Texto dentro de una tarjeta: la etiqueta pequeña y apagada, y el número grande. -->
    <Style Selector="TextBlock.statLabel">
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.statValue">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- El título y la descripción de una fila de ajuste. -->
    <Style Selector="TextBlock.title">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBlock.desc">
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="2,14,0,8" />
    </Style>

</Styles>
