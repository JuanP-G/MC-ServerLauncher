<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="McServerLauncher.App"
             RequestedThemeVariant="Dark">

    <!-- The four colours the app says things with, in one place.

         They were written out by hand 139 times across 22 files — the amber alone appeared
         sixteen times — with no resource of any kind defined here. Changing one meant sixteen
         edits and nothing to catch the one that was forgotten, and adding a fifth shade was
         easier than finding the right existing one, which is how a palette stops meaning
         anything.

         Same values as before, to the digit: this is where they live, not a redesign. The
         translucent variants are the fills and edges of the notice panels; they are named for
         what they are used for rather than for their alpha, because "the amber panel" is the
         decision and 0x22 is only how it is spelled.

         The defaults for the notification colours the user can change are NOT here: those are
         a setting, they live in NotificationPalette, and they happen to start on these. -->
    <Application.Resources>
        <SolidColorBrush x:Key="SemanticOk" Color="#3FB950" />
        <SolidColorBrush x:Key="SemanticInfo" Color="#2F6FB0" />
        <SolidColorBrush x:Key="SemanticWarn" Color="#E3A82B" />
        <SolidColorBrush x:Key="SemanticDanger" Color="#E05561" />

        <SolidColorBrush x:Key="SemanticWarnFill" Color="#22E3A82B" />
        <SolidColorBrush x:Key="SemanticWarnPanel" Color="#33E3A82B" />
        <SolidColorBrush x:Key="SemanticWarnEdge" Color="#55E3A82B" />

        <SolidColorBrush x:Key="SemanticDangerFill" Color="#22E05561" />
        <SolidColorBrush x:Key="SemanticDangerPanel" Color="#33E05561" />

        <!-- ===================== SUPERFICIES =====================
             Blanco translucido sobre el fondo oscuro. Van nombradas por el PAPEL que hacen, no por
             el valor: SurfaceChip y SurfaceEdge valen hoy lo mismo y son cosas distintas — el relleno
             de una pastilla y el borde de una tarjeta. Tener dos nombres es lo que permite cambiar
             uno sin arrastrar el otro; tener un solo valor repetido diez veces es lo que hacia que
             no se pudiera. -->
        <SolidColorBrush x:Key="SurfaceCard" Color="#15FFFFFF" />
        <SolidColorBrush x:Key="SurfaceChip" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="SurfaceChipStrong" Color="#2AFFFFFF" />
        <SolidColorBrush x:Key="SurfaceEdge" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="SurfaceEdgeSoft" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="SurfaceEdgeStrong" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="SurfaceEdgeHover" Color="#40FFFFFF" />

        <!-- ===================== FONDOS SOLIDOS =====================
             Los que no son translucidos: la barra lateral, los pozos donde va un icono, los paneles
             que flotan encima de todo, y el velo que se pone sobre una imagen al pasar el raton. -->
        <SolidColorBrush x:Key="GroundSidebar" Color="#11000000" />
        <SolidColorBrush x:Key="GroundWell" Color="#1A1A1A" />
        <SolidColorBrush x:Key="GroundPopup" Color="#1E1E1E" />
        <SolidColorBrush x:Key="GroundImage" Color="#22000000" />
        <SolidColorBrush x:Key="ScrimHover" Color="#99000000" />
        <SolidColorBrush x:Key="TextOnPopup" Color="#DDDDDD" />

        <!-- ===================== BOTONES SECUNDARIOS =====================
             Los que no son el azul principal (Atras, Cancelar, Configurar, Copiar...). Blanco
             translucido, cada estado un poco MAS claro que el anterior: el de Fluent se oscurecia al
             pasar el raton, y sobre el fondo negro eso es desaparecer. El borde es un degradado que
             hace de filo de luz arriba; en reposo apenas se ve, y al pasar el raton se enciende. -->
        <SolidColorBrush x:Key="ButtonRest" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="ButtonHover" Color="#40FFFFFF" />
        <SolidColorBrush x:Key="ButtonPressed" Color="#4AFFFFFF" />
        <LinearGradientBrush x:Key="ButtonEdge" StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Color="#24FFFFFF" Offset="0" />
            <GradientStop Color="#08FFFFFF" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ButtonLiftEdge" StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Color="#5CFFFFFF" Offset="0" />
            <GradientStop Color="#12FFFFFF" Offset="1" />
        </LinearGradientBrush>

        <!-- ===================== ACENTOS =====================  -->
        <SolidColorBrush x:Key="AccentSelected" Color="#58A6FF" />
        <SolidColorBrush x:Key="SparklineRam" Color="#5A8AB5" />
        <!-- El destello que cruza «+ Nuevo» (ver Styles/Motion.axaml): AccentSelected que aparece y
             se desvanece a lo ancho de una franja estrecha. -->
        <LinearGradientBrush x:Key="ShimmerSweep" StartPoint="0%,50%" EndPoint="100%,50%">
            <GradientStop Color="#0058A6FF" Offset="0" />
            <GradientStop Color="#7058A6FF" Offset="0.5" />
            <GradientStop Color="#0058A6FF" Offset="1" />
        </LinearGradientBrush>

        <!-- ===================== DESTRUCTIVO =====================
             Separado de los Semantic* de arriba porque no son lo mismo: SemanticDanger es el color
             con el que se AVISA de algo, y estos son con los que se pinta un boton que BORRA. Que
             haya dos rojos aqui es deliberado; que hubiera siete repartidos por las vistas, no. -->
        <SolidColorBrush x:Key="DangerButton" Color="#C42B1C" />
        <SolidColorBrush x:Key="DangerEdge" Color="#D13438" />
        <SolidColorBrush x:Key="DangerPanel" Color="#33D13438" />
        <SolidColorBrush x:Key="DangerIcon" Color="#FF8A8A" />
        <SolidColorBrush x:Key="DangerText" Color="#FFC9C9" />

        <!-- ===================== EL ASPECTO DE MINECRAFT =====================
             Esto NO es el tema de la app: es la lista de servidores de Minecraft, imitada a
             proposito para que la tarjeta se vea como la veran los jugadores. Cambiar el tema de la
             app no debe tocarlos, igual que no toca los 16 colores de MinecraftMotd. -->
        <SolidColorBrush x:Key="McListCard" Color="#FF2B2B2B" />
        <SolidColorBrush x:Key="McListEdge" Color="#3A3A3A" />
        <SolidColorBrush x:Key="McListText" Color="#AAAAAA" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- Los estilos que comparten varias vistas. Ver Styles/Shared.axaml para por que
             Border.card tuvo que quedarse con un solo significado. -->
        <StyleInclude Source="/Styles/Shared.axaml" />
        <!-- Todo el movimiento de la app: ver Styles/Motion.axaml. -->
        <StyleInclude Source="/Styles/Motion.axaml" />
        <!-- Keep button content (text and icon+text) centered everywhere. -->
        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Application.Styles>

</Application>
