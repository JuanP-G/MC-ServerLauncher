<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="McServerLauncher.App"
             RequestedThemeVariant="Dark">

    <!-- The four colours the app says things with, in one place.

         They were written out by hand 139 times across 22 files — the amber alone appeared
         sixteen times — with no resource of any kind defined here. Changing one meant sixteen
         edits and nothing to catch the one that was forgotten, and adding a fifth shade was
         easier than finding the right existing one, which is how a palette stops meaning
         anything.

         Same values as before, to the digit: this is where they live, not a redesign. The
         translucent variants are the fills and edges of the notice panels; they are named for
         what they are used for rather than for their alpha, because "the amber panel" is the
         decision and 0x22 is only how it is spelled.

         The defaults for the notification colours the user can change are NOT here: those are
         a setting, they live in NotificationPalette, and they happen to start on these. -->
    <Application.Resources>
        <SolidColorBrush x:Key="SemanticOk" Color="#3FB950" />
        <SolidColorBrush x:Key="SemanticInfo" Color="#2F6FB0" />
        <SolidColorBrush x:Key="SemanticWarn" Color="#E3A82B" />
        <SolidColorBrush x:Key="SemanticDanger" Color="#E05561" />

        <SolidColorBrush x:Key="SemanticWarnFill" Color="#22E3A82B" />
        <SolidColorBrush x:Key="SemanticWarnPanel" Color="#33E3A82B" />
        <SolidColorBrush x:Key="SemanticWarnEdge" Color="#55E3A82B" />

        <SolidColorBrush x:Key="SemanticDangerFill" Color="#22E05561" />
        <SolidColorBrush x:Key="SemanticDangerPanel" Color="#33E05561" />

        <!-- ===================== SURFACES =====================
             Translucent white over the dark background. Named for the ROLE they play, not for their
             value: SurfaceChip and SurfaceEdge happen to be the same today and are different things
             — the fill of a chip and the edge of a card. Having two names is what lets one change
             without dragging the other along; having one value repeated ten times is what made that
             impossible. -->
        <SolidColorBrush x:Key="SurfaceCard" Color="#15FFFFFF" />
        <SolidColorBrush x:Key="SurfaceChip" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="SurfaceChipStrong" Color="#2AFFFFFF" />
        <SolidColorBrush x:Key="SurfaceEdge" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="SurfaceEdgeSoft" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="SurfaceEdgeStrong" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="SurfaceEdgeHover" Color="#40FFFFFF" />

        <!-- ===================== SOLID BACKGROUNDS =====================
             The ones that are not translucent: the sidebar, the wells an icon sits in, the panels
             that float above everything, and the veil laid over an image on hover. -->
        <SolidColorBrush x:Key="GroundSidebar" Color="#11000000" />
        <SolidColorBrush x:Key="GroundWell" Color="#1A1A1A" />
        <SolidColorBrush x:Key="GroundPopup" Color="#1E1E1E" />
        <SolidColorBrush x:Key="GroundImage" Color="#22000000" />
        <SolidColorBrush x:Key="ScrimHover" Color="#99000000" />
        <SolidColorBrush x:Key="TextOnPopup" Color="#DDDDDD" />

        <!-- ===================== ACCENTS =====================  -->
        <SolidColorBrush x:Key="AccentSelected" Color="#58A6FF" />
        <SolidColorBrush x:Key="SparklineRam" Color="#5A8AB5" />

        <!-- ===================== DESTRUCTIVE =====================
             Kept apart from the Semantic* above because they are not the same thing: SemanticDanger
             is the colour something is WARNED about in, and these are what a button that DELETES is
             painted with. Two reds here is deliberate; the seven that were scattered across the
             views were not. -->
        <SolidColorBrush x:Key="DangerButton" Color="#C42B1C" />
        <SolidColorBrush x:Key="DangerEdge" Color="#D13438" />
        <SolidColorBrush x:Key="DangerPanel" Color="#33D13438" />
        <SolidColorBrush x:Key="DangerIcon" Color="#FF8A8A" />
        <SolidColorBrush x:Key="DangerText" Color="#FFC9C9" />

        <!-- ===================== THE MINECRAFT LOOK =====================
             This is NOT the app's theme: it is Minecraft's own server list, imitated on purpose so
             the card looks the way players will see it. Restyling the app must not touch these, the
             same way it does not touch MinecraftMotd's 16 colours. -->
        <SolidColorBrush x:Key="McListCard" Color="#FF2B2B2B" />
        <SolidColorBrush x:Key="McListEdge" Color="#3A3A3A" />
        <SolidColorBrush x:Key="McListText" Color="#AAAAAA" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- The styles several views share. See Styles/Shared.axaml for why Border.card had to be
             left meaning exactly one thing. -->
        <StyleInclude Source="/Styles/Shared.axaml" />
        <!-- Keep button content (text and icon+text) centered everywhere. -->
        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Application.Styles>

</Application>
