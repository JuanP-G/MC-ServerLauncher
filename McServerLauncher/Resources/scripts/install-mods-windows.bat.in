@echo off
chcp 65001 >nul
rem MC Server Launcher — mod installer for Windows.
rem
rem Every line of visible text is a placeholder replaced when the pack is built, so this file
rem holds the logic and the .resx files hold the wording. A placeholder always becomes a whole
rem finished message, never a format string.
rem
rem Nothing of the player's is ever deleted. Mods already in the destination are MOVED aside; the
rem one file this script removes is the loader installer it downloaded itself, into %TEMP%.
setlocal enabledelayedexpansion

rem Colour. Batch has no arrow-key input — that needs PowerShell, which mail providers block just
rem as hard as a .bat and which trips over the execution policy — so the menu below is choice.exe:
rem one keypress, no Enter, and every option on screen. The escape character has to be captured
rem from a prompt, because batch has no way to write one literally.
rem And only where the console understands them. Windows consoles older than build 10586 print the
rem escape sequences instead of acting on them, which would make the pack look broken to exactly
rem the person least able to tell that it is not. No colour is a fine outcome; gibberish is not.
set "BOLD=" & set "DIM=" & set "OK=" & set "WARN=" & set "OFF="
for /f "tokens=3" %%B in ('reg query "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion" /v CurrentBuild 2^>nul') do set "winbuild=%%B"
if defined winbuild if !winbuild! geq 10586 (
  for /f %%E in ('echo prompt $E ^| cmd') do set "ESC=%%E"
  set "BOLD=!ESC![1m"
  set "DIM=!ESC![90m"
  set "OK=!ESC![32m"
  set "WARN=!ESC![33m"
  set "OFF=!ESC![0m"
)

set "here=%~dp0"
set "source=%here%mods"

echo %BOLD%@@HEADER@@%OFF%
echo @@CLOSE_GAME@@
echo.

rem The commonest failure of all: run from inside the zip preview, where nothing sits alongside.
if not exist "%source%" (
  echo %WARN%@@NO_SOURCE@@%OFF%
  pause
  exit /b 1
)

rem --- Where the mods go ---------------------------------------------------------------------
rem Finding %%APPDATA%%\.minecraft proves the official launcher was installed once, never that it
rem is the one about to be used: Prism, MultiMC, CurseForge and Modrinth App keep mods per
rem instance. So every folder that really exists is offered, and picking one is a single keypress.
set "official=%APPDATA%\.minecraft"
set /a count=0

call :offer "%official%\mods" "@@LAUNCHER_OFFICIAL@@"

for /d %%I in ("%APPDATA%\PrismLauncher\instances\*") do (
  call :offer "%%~fI\minecraft\mods" "%%~nxI"
  call :offer "%%~fI\.minecraft\mods" "%%~nxI"
)
for /d %%I in ("%APPDATA%\.multimc\instances\*") do call :offer "%%~fI\.minecraft\mods" "%%~nxI"
for /d %%I in ("%APPDATA%\ModrinthApp\profiles\*") do call :offer "%%~fI\mods" "%%~nxI"
for /d %%I in ("%USERPROFILE%\curseforge\minecraft\Instances\*") do call :offer "%%~fI\mods" "%%~nxI"

set "destination=%official%\mods"

if defined MCSL_MODS_DIR (
  set "destination=%MCSL_MODS_DIR%"
  goto :chosen
)
if !count! gtr 1 goto :menu
if !count! equ 1 (
  set "destination=!cand[1]!"
  goto :chosen
)
if not exist "%destination%" goto :typepath
goto :chosen

:menu
echo.
echo %BOLD%@@ASK_FOLDER@@%OFF%
echo.
set "keys="
for /l %%N in (1,1,!count!) do (
  echo    %%N^) !label[%%N]!  %DIM%!cand[%%N]!%OFF%
  set "keys=!keys!%%N"
)
set /a other=count+1
echo    !other!^) @@OTHER_PATH@@
set "keys=!keys!!other!"
echo.
rem /t and /d on every choice: batch has no way to ask whether anything is listening, so a
rem redirected or scripted run would sit here for ever waiting for a keypress that cannot come.
rem A timeout with a sensible default ends that, and a player who walks away gets it too.
choice /c !keys! /n /t 30 /d 1 /m "@@PICK_ONE@@ "
if !errorlevel! equ !other! goto :typepath
for /l %%N in (1,1,!count!) do if !errorlevel! equ %%N set "destination=!cand[%%N]!"
goto :chosen

:typepath
echo.
set "typed="
set /p "typed=@@TYPE_PATH@@ "
if not "!typed!"=="" set "destination=!typed!"

:chosen
echo.
echo @@DESTINATION_IS@@ %BOLD%!destination!%OFF%

rem --- The loader ----------------------------------------------------------------------------
rem The likeliest way for this to end badly is mods landing beside a Minecraft that cannot load
rem them.
for %%I in ("!destination!\..") do set "mcdir=%%~fI"

set "loaderfound=0"
if exist "!mcdir!\versions" (
  for /d %%V in ("!mcdir!\versions\*@@LOADER_MARK@@*") do set "loaderfound=1"
)

if "!loaderfound!"=="1" goto :copy

echo.
echo %WARN%@@NO_LOADER@@%OFF%

if "@@INSTALLER_URL@@"=="" goto :askcontinue

choice /c @@YES_NO_KEYS@@ /n /t 30 /d @@DEFAULT_YES@@ /m "@@ASK_INSTALL@@ "
if !errorlevel! equ 2 (
  echo @@CARRYING_ON@@
  goto :copy
)
call :installloader
goto :copy

:askcontinue
rem No installer resolved when the pack was built — offline, most likely. Ask before copying mods
rem next to a Minecraft that will not load them, but never refuse: the check can be wrong.
choice /c @@YES_NO_KEYS@@ /n /t 30 /d @@DEFAULT_YES@@ /m "@@ASK_CONTINUE@@ "
if !errorlevel! equ 2 (
  echo @@CANCELLED@@
  pause
  exit /b 1
)
goto :copy

:copy
if not exist "!destination!" mkdir "!destination!" 2>nul
if not exist "!destination!" (
  echo %WARN%@@CANNOT_CREATE@@%OFF%
  pause
  exit /b 1
)

rem Aside, as a sibling rather than a subfolder: visible in Explorer, and never rescanned as mods.
rem A half-done install is worse than none, so a failed move stops everything there and then.
set "backup=!mcdir!\mods-backup-@@STAMP@@"
set /a moved=0
for %%F in ("!destination!\*.jar") do (
  if not exist "!backup!" mkdir "!backup!" 2>nul
  move "%%~fF" "!backup!\" >nul || (
    echo %WARN%@@MOVE_FAILED@@ %%~nxF%OFF%
    pause
    exit /b 1
  )
  set /a moved+=1
)
if !moved! gtr 0 echo @@MOVED_ASIDE@@ !moved! -^> "!backup!"

set /a copied=0
for %%F in ("%source%\*.jar") do (
  copy /y "%%~fF" "!destination!\" >nul || (
    echo %WARN%@@COPY_FAILED@@ %%~nxF%OFF%
    pause
    exit /b 1
  )
  set /a copied+=1
)

echo.
echo %OK%@@DONE@@ !copied! -^> "!destination!"%OFF%
if !moved! gtr 0 echo @@HOW_TO_UNDO@@ "!backup!"
rem A .bat opened by double-click closes the instant it ends, so the result would never be read.
pause
exit /b 0

rem --- Subroutines -----------------------------------------------------------------------------

:offer
rem %1 = mods folder, %2 = what to call it. Only if it is really there, and only once.
if not exist %1 goto :eof
for /l %%N in (1,1,!count!) do if /i "!cand[%%N]!"==%~1 goto :eof
set /a count+=1
set "cand[!count!]=%~1"
set "label[!count!]=%~2"
goto :eof

:installloader
rem Java, which the installers need and most players have without knowing: the official launcher
rem keeps its own JRE under the Minecraft folder and never puts it on the PATH.
set "javabin="
for /f "delims=" %%J in ('where java 2^>nul') do if not defined javabin set "javabin=%%J"
if not defined javabin (
  for /r "!mcdir!\runtime" %%J in (java.exe) do if not defined javabin set "javabin=%%~fJ"
)
if not defined javabin (
  echo %WARN%@@NO_JAVA@@%OFF%
  goto :eof
)

set "installer=%TEMP%\mcsl-loader-installer.jar"
echo @@DOWNLOADING@@

where curl >nul 2>nul && (
  curl -fsSL -o "!installer!" "@@INSTALLER_URL@@"
) || (
  certutil -urlcache -split -f "@@INSTALLER_URL@@" "!installer!" >nul
)
if not exist "!installer!" (
  echo %WARN%@@DOWNLOAD_FAILED@@%OFF%
  goto :eof
)

rem Verified against the hash the pack was built with, taken from the loader's own maven
rem repository. This is a jar about to be executed on somebody else's machine: an unverified
rem download would be the least defensible thing in the whole pack.
set "actual="
for /f "skip=1 delims=" %%H in ('certutil -hashfile "!installer!" @@SHA_ALGO_WIN@@ 2^>nul') do (
  if not defined actual set "actual=%%H"
)
set "actual=!actual: =!"

if /i not "!actual!"=="@@INSTALLER_SHA@@" (
  echo %WARN%@@HASH_MISMATCH@@%OFF%
  del "!installer!" >nul 2>nul
  goto :eof
)

echo @@INSTALLING@@
"!javabin!" -jar "!installer!" @@INSTALLER_ARGS@@ "!mcdir!"
if errorlevel 1 (
  echo %WARN%@@INSTALL_FAILED@@%OFF%
) else (
  echo %OK%@@LOADER_INSTALLED@@%OFF%
)
del "!installer!" >nul 2>nul
goto :eof
