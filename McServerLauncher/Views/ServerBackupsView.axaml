<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:McServerLauncher.ViewModels"
             xmlns:loc="using:McServerLauncher.Localization"
             xmlns:ic="using:FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="McServerLauncher.Views.ServerBackupsView"
             x:DataType="vm:ServerBackupsViewModel"
             x:CompileBindings="False">

    <!-- A server's backups: how full each of the two piles is, how much room they take and when the
         next one comes; then the backups themselves, by day, filtered by pile. -->
    <UserControl.Styles>
        <Style Selector="Border.pile">
            <Setter Property="Background" Value="{StaticResource SurfaceCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style Selector="TextBlock.big">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style Selector="ProgressBar.fill">
            <Setter Property="Height" Value="4" />
            <Setter Property="MinHeight" Value="4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style Selector="ToggleButton.chip">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.day">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Margin" Value="6,12,0,4" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*" Margin="0,8,0,0">

        <!-- The two piles and the room they take. -->
        <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,10">
            <Border Classes="pile">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Backup_Automatic}" Classes="desc" />
                    <TextBlock Text="{Binding AutomaticCountText}" Classes="big" />
                    <ProgressBar Classes="fill" Minimum="0" Maximum="100" Value="{Binding AutomaticFill}" />
                    <TextBlock Text="{loc:Loc Backup_AutomaticWhat}" Classes="desc" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Classes="pile">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Backup_Manual}" Classes="desc" />
                    <TextBlock Text="{Binding ManualCountText}" Classes="big" />
                    <ProgressBar Classes="fill" Minimum="0" Maximum="100" Value="{Binding ManualFill}" />
                    <TextBlock Text="{loc:Loc Backup_ManualWhat}" Classes="desc" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Classes="pile">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Backup_Space}" Classes="desc" />
                    <TextBlock Text="{Binding TotalSizeText}" Classes="big" />
                    <TextBlock Text="{Binding NextBackupText}" Classes="desc" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Make one, the way to the limits, and which pile to look at — the filter on a line of its
             own, so that a narrow window does not push the buttons out of it. -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto" Margin="4,0,4,8">
            <Button Grid.Column="0" Classes="accent" Command="{Binding BackupNowCommand}"
                    IsEnabled="{Binding CanBackupNow}" Margin="0,0,12,0"
                    ToolTip.Tip="{loc:Loc Backup_NeedsStoppedTip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ic:SymbolIcon Symbol="Save" />
                    <TextBlock Text="{loc:Loc Backup_NowButton}" />
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Opacity="0.75" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,8,0" />

            <Button Grid.Column="2" Margin="0,0,8,0" Padding="8,4" VerticalAlignment="Center"
                    Command="{Binding DataContext.OpenBackupSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ic:SymbolIcon Symbol="Settings" FontSize="14" />
                    <TextBlock Text="{loc:Loc Backup_AdjustLimits}" />
                </StackPanel>
            </Button>

            <Button Grid.Column="3" Command="{Binding RefreshCommand}" Padding="6,4" VerticalAlignment="Center"
                    ToolTip.Tip="{loc:Loc Refresh}">
                <ic:SymbolIcon Symbol="ArrowClockwise" />
            </Button>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                <ToggleButton Classes="chip" Content="{loc:Loc Backup_All}"
                              IsChecked="{Binding IsAllFilter, Mode=OneWay}" Command="{Binding ShowAllCommand}" />
                <ToggleButton Classes="chip" Content="{loc:Loc Backup_Automatic}"
                              IsChecked="{Binding IsAutomaticFilter, Mode=OneWay}" Command="{Binding ShowAutomaticCommand}" />
                <ToggleButton Classes="chip" Content="{loc:Loc Backup_Manual}"
                              IsChecked="{Binding IsManualFilter, Mode=OneWay}" Command="{Binding ShowManualCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceCard}" BorderBrush="{StaticResource SurfaceEdge}" BorderThickness="1"
                CornerRadius="8" Padding="8,4,8,8">
            <Panel>
                <TextBlock Text="{loc:Loc Backup_NoneYet}" Opacity="0.7"
                           HorizontalAlignment="Center" Margin="0,24,0,0" IsVisible="{Binding IsEmpty}" />
                <TextBlock Text="{loc:Loc Backup_NoneInFilter}" Opacity="0.7"
                           HorizontalAlignment="Center" Margin="0,24,0,0" IsVisible="{Binding IsFilterEmpty}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Classes="day" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource GroundWell}" CornerRadius="6" Padding="10,8" Margin="0,2"
                                                        ToolTip.Tip="{Binding FileName}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15" Margin="0,0,10,0"
                                                                Background="{StaticResource SurfaceChip}" VerticalAlignment="Center">
                                                            <ic:SymbolIcon Symbol="{Binding Icon}" FontSize="15"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <WrapPanel Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="{StaticResource McListText}" />
                                                                <TextBlock Text="{Binding Goes, StringFormat='  ·  {0}'}" FontSize="12"
                                                                           Foreground="{StaticResource SemanticWarn}" IsVisible="{Binding IsGoing}" />
                                                            </WrapPanel>
                                                        </StackPanel>

                                                        <Button Grid.Column="2" Margin="8,0,8,0" Padding="10,4" VerticalAlignment="Center"
                                                                Content="{loc:Loc Backup_RestoreButton}"
                                                                Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding DataContext.CanRestore, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                ToolTip.Tip="{loc:Loc Backup_RestoreNeedsStoppedTip}" />

                                                        <Button Grid.Column="3" ToolTip.Tip="{loc:Loc Tip_Delete}" Background="Transparent" Padding="6"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <ic:SymbolIcon Symbol="Delete" Foreground="{StaticResource SemanticDanger}" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Panel>
        </Border>
    </Grid>
</UserControl>
