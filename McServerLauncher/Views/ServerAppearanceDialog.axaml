<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:McServerLauncher.Localization"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:views="using:McServerLauncher.Views"
        x:Class="McServerLauncher.Views.ServerAppearanceDialog"
        x:CompileBindings="False"
        Title="{loc:Loc Look_Title}"
        Width="640" Height="780" MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0" Margin="20,20,20,4" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ===================== VISTA PREVIA =====================
                     La misma tarjeta que la ventana principal. Con "entrar para encenderlo" activado
                     la lista de Minecraft enseña una cosa dormido y otra encendido, y las dos se pueden ver. -->
                <Border Classes="card">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{loc:Loc Look_Preview}" Classes="title" VerticalAlignment="Center" />
                            <StackPanel x:Name="PreviewModeRow" Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="False">
                                <RadioButton x:Name="PreviewAsleep" GroupName="PreviewMode" Content="{loc:Loc Look_PreviewAsleep}" />
                                <RadioButton x:Name="PreviewAwake" GroupName="PreviewMode" Content="{loc:Loc Look_PreviewAwake}" />
                            </StackPanel>
                        </Grid>
                        <views:ServerCardView x:Name="Preview" />
                    </StackPanel>
                </Border>

                <!-- ===================== IMAGEN ===================== -->
                <Border Classes="card">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Width="56" Height="56" CornerRadius="4" ClipToBounds="True"
                                Background="{StaticResource GroundWell}" VerticalAlignment="Top">
                            <Panel>
                                <ic:SymbolIcon x:Name="IconPlaceholder" Symbol="Server" FontSize="24" Opacity="0.5"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="IconImage" Width="56" Height="56"
                                       RenderOptions.BitmapInterpolationMode="None" />
                            </Panel>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="{loc:Loc Look_Image}" Classes="title" />
                            <TextBlock Classes="desc" Text="{loc:Loc Look_ImageDesc}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button Content="{loc:Loc Look_ChangeImage}" Click="ChangeImage_Click" />
                                <Button x:Name="RemoveImageButton" Content="{loc:Loc Look_RemoveImage}" Click="RemoveImage_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===================== NOMBRE ===================== -->
                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Look_Name}" Classes="title" />
                        <TextBlock Classes="desc" Text="{loc:Loc Look_NameDesc}" />
                        <TextBox x:Name="NameBox" Margin="0,8,0,0" MaxLength="64" />
                    </StackPanel>
                </Border>

                <!-- ===================== TEXTO ===================== -->
                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Look_Motd}" Classes="title" />
                        <TextBlock Classes="desc" Text="{loc:Loc Look_MotdDesc}" />

                        <!-- Barra de formato. Nada de ella toma el foco: si lo tomara, la caja de texto
                             perdería la selección justo antes de que el botón la lea. Los 16 colores se
                             crean desde la paleta de MinecraftMotd, así que no hay un solo hex aquí. -->
                        <WrapPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <StackPanel x:Name="ColorPanel" Orientation="Horizontal" Spacing="3" Margin="0,0,10,4" />
                            <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,0,0,4">
                                <Button x:Name="BoldButton" Focusable="False" Width="30" Height="26" Padding="0"
                                        ToolTip.Tip="{loc:Loc Look_Bold}" Click="Format_Click" Tag="Bold">
                                    <TextBlock Text="B" FontWeight="Bold" />
                                </Button>
                                <Button x:Name="ItalicButton" Focusable="False" Width="30" Height="26" Padding="0"
                                        ToolTip.Tip="{loc:Loc Look_Italic}" Click="Format_Click" Tag="Italic">
                                    <TextBlock Text="I" FontStyle="Italic" />
                                </Button>
                                <Button x:Name="UnderlineButton" Focusable="False" Width="30" Height="26" Padding="0"
                                        ToolTip.Tip="{loc:Loc Look_Underline}" Click="Format_Click" Tag="Underline">
                                    <TextBlock Text="U" TextDecorations="Underline" />
                                </Button>
                                <Button x:Name="StrikeButton" Focusable="False" Width="30" Height="26" Padding="0"
                                        ToolTip.Tip="{loc:Loc Look_Strike}" Click="Format_Click" Tag="Strike">
                                    <TextBlock Text="S" TextDecorations="Strikethrough" />
                                </Button>
                                <Button x:Name="ClearButton" Focusable="False" Height="26" Padding="8,0"
                                        ToolTip.Tip="{loc:Loc Look_ClearFormat}" Click="Clear_Click">
                                    <ic:SymbolIcon Symbol="TextClearFormatting" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </WrapPanel>

                        <TextBlock Text="{loc:Loc Look_Line1}" Classes="desc" Margin="0,4,0,2" />
                        <TextBox x:Name="Line1Box" FontFamily="Cascadia Mono, Consolas, monospace" />

                        <TextBlock Text="{loc:Loc Look_Line2}" Classes="desc" Margin="0,8,0,2" />
                        <TextBox x:Name="Line2Box" FontFamily="Cascadia Mono, Consolas, monospace" />
                        <TextBlock x:Name="Line2Note" Classes="desc" Text="{loc:Loc Look_Line2Locked}" IsVisible="False" />

                        <TextBlock x:Name="ExtraLinesNote" Classes="desc" Text="{loc:Loc Look_ExtraLines}"
                                   Foreground="{StaticResource SemanticWarn}" IsVisible="False" />
                    </StackPanel>
                </Border>

                <Border x:Name="RestartNote" Classes="card" IsVisible="False"
                        Background="{StaticResource SemanticWarnFill}" BorderBrush="{StaticResource SemanticWarnEdge}">
                    <TextBlock Text="{loc:Loc Look_AppliesOnRestart}" TextWrapping="Wrap" FontSize="12.5" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,8,20,16" Spacing="8">
            <Button Content="{loc:Loc Cancel}" Click="Cancel_Click" />
            <Button Classes="accent" Content="{loc:Loc Save}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
