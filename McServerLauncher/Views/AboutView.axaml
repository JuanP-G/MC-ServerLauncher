<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:McServerLauncher.Localization"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:svc="using:McServerLauncher.Services"
             x:Class="McServerLauncher.Views.AboutView"
             x:CompileBindings="False">

    <!-- DataContext: MainViewModel (the version and the state of the update check live there). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" Spacing="12" MaxWidth="720" HorizontalAlignment="Left">

            <Grid ColumnDefinitions="Auto,*">
                <Image Source="avares://McServerLauncher/Resources/app.ico" Width="56" Height="56"
                       VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="MC Server Launcher" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Classes="desc" Margin="0" Text="{Binding VersionLineText}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{loc:Loc About_Tagline}" TextWrapping="Wrap" Opacity="0.85" />

            <!-- Updates: actually look, and say which of the three things happened -->
            <Border Classes="card" Margin="0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Panel Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
                        <ic:SymbolIcon Symbol="CheckmarkCircle" FontSize="20" Foreground="{StaticResource SemanticOk}"
                                       IsVisible="{Binding IsUpToDate}" />
                        <ic:SymbolIcon Symbol="ErrorCircle" FontSize="20" Foreground="{StaticResource SemanticWarn}"
                                       IsVisible="{Binding UpdateCheckFailed}" />
                        <ic:SymbolIcon Symbol="ArrowDownload" FontSize="20" Foreground="{StaticResource AccentSelected}"
                                       IsVisible="{Binding UpdateAvailable}" />
                        <ProgressBar IsIndeterminate="True" Width="20" IsVisible="{Binding IsCheckingUpdates}" />
                    </Panel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc Upd_Title}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding UpdateCheckText}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="accent" Content="{loc:Loc Update_Now}" Command="{Binding UpdateNowCommand}"
                                IsVisible="{Binding UpdateAvailable}" />
                        <Button Command="{Binding CheckForUpdatesNowCommand}" IsEnabled="{Binding !IsCheckingUpdates}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="ArrowSync" />
                                <TextBlock Text="{loc:Loc Upd_Check}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Repository links -->
            <WrapPanel Orientation="Horizontal">
                <Button Margin="0,0,8,8" Command="{Binding OpenLinkCommand}"
                        CommandParameter="{x:Static svc:AppLinks.Repository}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Symbol="Code" />
                        <TextBlock Text="{loc:Loc About_Repo}" />
                    </StackPanel>
                </Button>
                <Button Margin="0,0,8,8" Command="{Binding OpenLinkCommand}"
                        CommandParameter="{x:Static svc:AppLinks.NewIssue}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Symbol="Bug" />
                        <TextBlock Text="{loc:Loc About_Issue}" />
                    </StackPanel>
                </Button>
                <Button Margin="0,0,8,8" Command="{Binding OpenLinkCommand}"
                        CommandParameter="{x:Static svc:AppLinks.Releases}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Symbol="Tag" />
                        <TextBlock Text="{loc:Loc About_Releases}" />
                    </StackPanel>
                </Button>
                <Button Margin="0,0,8,8" Command="{Binding OpenLinkCommand}"
                        CommandParameter="{x:Static svc:AppLinks.Website}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon Symbol="Globe" />
                        <TextBlock Text="{loc:Loc About_Web}" />
                    </StackPanel>
                </Button>
            </WrapPanel>

            <!-- Creditos -->
            <StackPanel Spacing="6">
                <TextBlock Text="{loc:Loc About_BuiltOn}" FontWeight="SemiBold" />
                <ItemsControl x:Name="Credits">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceChip}" CornerRadius="6" Padding="9,3" Margin="0,0,6,6">
                                <TextBlock Text="{Binding}" FontSize="12" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Legal -->
            <StackPanel Spacing="6">
                <TextBlock Text="{loc:Loc About_Legal}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Loc Pk_Disclaimer}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Padding="6,2" Background="Transparent" Command="{Binding OpenLinkCommand}"
                            CommandParameter="{x:Static svc:AppLinks.License}"
                            Content="{loc:Loc About_License}" />
                    <Button Padding="6,2" Background="Transparent" Command="{Binding OpenLinkCommand}"
                            CommandParameter="{x:Static svc:AppLinks.Notice}"
                            Content="{loc:Loc About_Notice}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
