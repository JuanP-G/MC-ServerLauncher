<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="using:McServerLauncher.Behaviors"
        xmlns:loc="using:McServerLauncher.Localization"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:views="using:McServerLauncher.Views"
        xmlns:vm="using:McServerLauncher.ViewModels"
        xmlns:controls="using:McServerLauncher.Controls"
        x:Class="McServerLauncher.Views.MainWindow"
        x:CompileBindings="False"
        Title="MC Server Launcher"
        Icon="/Resources/app.ico"
        Width="1150" Height="720"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- ARRANCAR, PARAR, REINICIAR. Con nombre y con color, porque son las tres acciones que
             de verdad hacen algo y estaban indistinguibles: dos iconos grises del mismo tamaño.
             Los colores salen de las fichas que ya existen; no hay un verde nuevo. -->
        <Style Selector="Button.run">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <!-- 10 y no 13: con 13 los tres sumaban 406 px y la tarjeta del servidor se quedaba en
                 342, con el cartel cortado a "Survival | …". El cartel es lo que la tarjeta viene a
                 enseñar. -->
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.run.go">
            <Setter Property="Background" Value="{StaticResource SemanticOk}" />
            <Setter Property="BorderBrush" Value="{StaticResource SemanticOk}" />
        </Style>
        <Style Selector="Button.run.stop">
            <Setter Property="Background" Value="{StaticResource DangerButton}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerEdge}" />
        </Style>
        <Style Selector="Button.run.again">
            <Setter Property="Background" Value="{StaticResource SemanticWarn}" />
            <Setter Property="BorderBrush" Value="{StaticResource SemanticWarn}" />
            <Setter Property="Foreground" Value="{StaticResource TextOnWarn}" />
        </Style>
        <!-- Deshabilitado tiene que LEERSE como deshabilitado: sin esto, un boton de color plano
             sigue gritando "pulsame" cuando no se puede pulsar. -->
        <Style Selector="Button.run:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <!-- Cada medida es una TARJETA: icono y etiqueta arriba, el numero grande debajo, y el
             minigrafico al pie cuando la medida tiene serie. Antes era una tira de texto a media
             altura; el numero es lo que se viene a mirar y era lo que menos se veia.
             Sin medias, ni maximos, ni hora de inicio: eso habria que calcularlo y no se pidio. -->
        <Style Selector="Border.mcard">
            <Setter Property="Background" Value="{StaticResource SurfaceCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <!-- Medido: con 12,9 de relleno y el numero a 20, la fila de tarjetas costaba 95 px y
                 la consola bajaba de 493 a 418 — casi todo lo ganado en el reparto. Apretada, cuesta
                 unos 20 menos sin dejar de ser una tarjeta. -->
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="MinWidth" Value="150" />
        </Style>
        <!-- El pozo del icono: un cuadrado apagado a la izquierda, para que el numero mande y el
             icono solo diga de que medida es. -->
        <Style Selector="Border.mcardIcon">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{StaticResource SurfaceChip}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.mcardIcon > ic|SymbolIcon">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="TextBlock.mcardLabel">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.metricValue">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <!-- La barra entre dos numeros que van juntos (puerto Java / Bedrock, ping directo / tunel).
             Apagada a proposito: separa, no compite con las cifras. -->
        <Style Selector="TextBlock.metricSep">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Opacity" Value="0.35" />
            <Setter Property="Margin" Value="5,0,5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- LAS DIRECCIONES. Botones y no cajas de texto de solo lectura: lo que se hace con una
             direccion es copiarla y mandarsela a alguien, asi que el gesto es un clic sobre ella
             entera, no seleccionar el texto a mano. -->
        <Style Selector="Button.addrpill">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{StaticResource SurfaceChip}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0,0,7,0" />
        </Style>
        <Style Selector="Button.addrpill:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceEdgeHover}" />
        </Style>
        <!-- Los puertos locales: mismo aspecto que una direccion pero sin ser pulsable, porque no
             hay nada util que copiar. -->
        <Style Selector="Border.portpill">
            <Setter Property="Background" Value="{StaticResource SurfaceCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.addrpill.icon">
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style Selector="TextBlock.addrKey">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.addrValue">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- EL LAPIZ de la tarjeta. Callado hasta que te acercas: es cromo de la app dentro de algo
             que imita la lista de Minecraft, asi que a plena opacidad ensuciaria la imitacion. -->
        <Style Selector="Button.pencil">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Border.mccard:pointerover Button.pencil">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="{StaticResource SurfaceChip}" />
        </Style>
        <Style Selector="Button.pencil:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- LAS PESTANAS. Nadie estilizaba TabItem en todo el repo, asi que eran ~48 px de cromo
             Fluent por defecto justo encima de lo mas usado. Se estiliza por CLASE y no con
             `Selector="TabItem"` a secas, por lo mismo que Border.card tuvo que quedarse con un
             solo significado: un selector sin clase alcanza a cualquier pestaña que se añada luego. -->
        <Style Selector="TabControl.slim > TabItem">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <!-- Una entrada del rail. Icono arriba y etiqueta debajo: un rail de solo iconos
             obliga a adivinar, y "Tuneles" no tiene un icono que se entienda solo. -->
        <Style Selector="Button.rail">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="4,9,4,7" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Opacity" Value="0.62" />
        </Style>
        <Style Selector="Button.rail:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- La seccion en la que estas: a plena opacidad, y la barra de la izquierda dice cual es.
             Antes esto pintaba tambien un fondo, y con la barra puesta eran DOS señales diciendo lo
             mismo — una de ellas ademas apareciendo de golpe mientras la otra viajaba. -->
        <Style Selector="Button.rail.on">
            <Setter Property="Opacity" Value="1" />
        </Style>

    </Window.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Update-available banner -->
        <Border Grid.Row="0" Background="{StaticResource SemanticInfo}" Padding="14,8" IsVisible="{Binding UpdateAvailable}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <ic:SymbolIcon Grid.Column="0" Symbol="ArrowDownload" Foreground="White"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding UpdateText}" Foreground="White" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="{loc:Loc Update_Now}" Margin="0,0,8,0" Command="{Binding UpdateNowCommand}" />
                <Button Grid.Column="3" Background="Transparent" Foreground="White"
                        Command="{Binding DismissUpdateCommand}" ToolTip.Tip="{loc:Loc Tip_Hide}">
                    <ic:SymbolIcon Symbol="Dismiss" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="78,*">

            <!-- Los ambitos de la app. Antes no habia ningun sitio para lo que no es de un
                 servidor concreto, asi que Playit acababa dentro del servidor y Ajustes colgando
                 del pie de la lista. Servidores y Tuneles cambian lo que llena la ventana;
                 Ajustes y Acerca de abren su dialogo, que es lo que ya eran. -->
            <Border Grid.Column="0" Background="{StaticResource GroundPopup}" Padding="6,10">
                <!-- Un Panel y no la rejilla a secas: la marca se SUPERPONE a los botones a
                     proposito, y superponer es lo que hace un Panel. Metida dentro de la rejilla
                     compartiria celda con el boton de Servidores, que es justo lo que GridColumnTests
                     existe para cazar — y tendria razon, porque desde el XAML no habria forma de
                     distinguir esa superposicion de un Grid.Row olvidado. -->
                <Panel>
                    <!-- La marca de "estas aqui". UNA, que viaja, en vez de dos fondos que se
                         encienden por su cuenta: asi el cambio de seccion se ve como un movimiento y
                         no como dos parpadeos. Su sitio y su alto los calcula el code-behind
                         midiendo los botones, porque las filas del rail son Auto y una traduccion
                         larga —"Einstellungen"— parte la etiqueta en dos lineas y desnivela los
                         botones. Cualquier desplazamiento fijo se descuadraria al traducir. -->
                    <Border x:Name="RailPip" Classes="railpip" Width="3" CornerRadius="2"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="{StaticResource AccentSelected}" />

                <Grid x:Name="RailGrid" RowDefinitions="Auto,Auto,*,Auto,Auto">
                    <Button Grid.Row="0" x:Name="RailServers" Classes="rail" Classes.on="{Binding IsServersSection}"
                            Command="{Binding ShowServersCommand}">
                        <StackPanel Spacing="3">
                            <ic:SymbolIcon Symbol="Server" FontSize="19" HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Loc Nav_Servers}" FontSize="10.5" TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="1" x:Name="RailTunnels" Classes="rail" Classes.on="{Binding IsTunnelsSection}"
                            Command="{Binding ShowTunnelsCommand}">
                        <StackPanel Spacing="3">
                            <ic:SymbolIcon Symbol="Globe" FontSize="19" HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Loc Nav_Tunnels}" FontSize="10.5" TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="3" Classes="rail" Command="{Binding OpenSettingsCommand}">
                        <StackPanel Spacing="3">
                            <ic:SymbolIcon Symbol="Settings" FontSize="19" HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Loc Settings_Title}" FontSize="10.5" TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="4" Classes="rail" Command="{Binding OpenAboutCommand}">
                        <StackPanel Spacing="3">
                            <ic:SymbolIcon Symbol="Info" FontSize="19" HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Loc About_Title}" FontSize="10.5" TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Button>
                </Grid>
                </Panel>
            </Border>

            <!-- Tuneles -->
            <!-- Opacidad y no IsVisible: false saca el elemento del layout, asi que no queda nada
                 que fundir. Las dos secciones se quedan montadas y se cruzan.
                 IsEnabled va atado a lo mismo porque un panel a opacidad cero SIGUE recibiendo
                 clics y foco de tabulador, y un clic que va a algo que no se ve es peor fallo que
                 el que veniamos a arreglar. -->
            <views:TunnelsView Grid.Column="1" Classes="section"
                               Opacity="{Binding TunnelsOpacity}"
                               IsEnabled="{Binding IsTunnelsSection}" />

            <!-- Servidores -->
            <Grid Grid.Column="1" ColumnDefinitions="236,*" Classes="section"
                  Opacity="{Binding ServersOpacity}"
                  IsEnabled="{Binding IsServersSection}">

            <!-- Side panel: server list -->
            <Border Grid.Column="0" Background="{StaticResource GroundSidebar}" Padding="12">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0" Text="{loc:Loc Servers}" FontSize="18" FontWeight="SemiBold" Margin="4,0,0,10" />

                    <ListBox Grid.Row="1" Classes="servers"
                             ItemsSource="{Binding Servers}"
                             SelectedItem="{Binding SelectedServer}"
                             Background="Transparent"
                             HorizontalAlignment="Stretch"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,6" ColumnDefinitions="Auto,*,Auto">
                                    <!-- Status dot with a colored halo -->
                                    <Panel Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Ellipse Fill="{Binding StatusBrush}" Opacity="0.25" />
                                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Panel>

                                    <!-- Todo lo de esta columna tiene que poder encogerse.
                                         Un Grid no recorta a sus hijos: si el nombre y la etiqueta
                                         piden mas ancho del que hay, no se cortan — se salen, y el
                                         numero de jugadores de la derecha se dibuja encima. Solo
                                         pasaba con el servidor encendido, porque es cuando ese
                                         numero aparece, y por eso no salia en ninguna captura con
                                         los servidores parados. -->
                                    <StackPanel Grid.Column="1" ClipToBounds="True">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Name}" />
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                                            <Border Grid.Column="0" CornerRadius="4" Padding="5,1"
                                                    VerticalAlignment="Center" Margin="0,0,6,0"
                                                    Background="{Binding ServerTypeBrush}">
                                                <TextBlock Text="{Binding ServerTypeText}" FontSize="10"
                                                           FontWeight="SemiBold" Foreground="White" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- Connected players when running -->
                                    <TextBlock Grid.Column="2" Text="{Binding PlayerCountText}" FontSize="12"
                                               Foreground="{Binding SignalBrush}" VerticalAlignment="Center"
                                               Margin="8,0,2,0" IsVisible="{Binding IsRunning}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="8">
                        <Button Classes="accent" HorizontalAlignment="Stretch" Command="{Binding CreateServerCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <ic:SymbolIcon Symbol="Sparkle" />
                                <TextBlock Text="{loc:Loc CreateServer}" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Command="{Binding AddServerCommand}" ToolTip.Tip="{loc:Loc Tip_Add}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:SymbolIcon Symbol="FolderAdd" />
                                    <TextBlock Text="{loc:Loc Add}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding EditServerCommand}" ToolTip.Tip="{loc:Loc Tip_Edit}">
                                <ic:SymbolIcon Symbol="Edit" />
                            </Button>
                            <Button Command="{Binding RemoveServerCommand}" ToolTip.Tip="{loc:Loc Tip_Delete}">
                                <ic:SymbolIcon Symbol="Delete" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main panel: selected server detail -->
            <Panel Grid.Column="1" Margin="16">
                <TextBlock Text="{loc:Loc EmptyState}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="16" Opacity="0.6"
                           IsVisible="{Binding !HasSelection}" />

                <!-- Reparto "dos pisos". Antes esto eran tres columnas Auto,*,Auto con las medidas
                     en la del medio: medido, les quedaban 164 px de ancho y cada una pedia 146
                     fijos, asi que las siete caian de una en una y la cabecera media 189 px, no los
                     90 que decia su propio comentario.

                     A 900 px era peor que feo: la columna de las medidas se quedaba en CERO —las
                     siete desaparecian— y los botones se dibujaban hasta x=640 dentro de un panel
                     de 554, o sea fuera de la ventana. Por eso la tarjeta de aqui abajo PUEDE
                     encoger: entre una tarjeta mas estrecha y un boton que no existe, no hay duda. -->
                <Grid DataContext="{Binding SelectedServer}"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,*"
                      IsVisible="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}}">

                    <!-- ===== Piso 1: quien es el servidor, como va, y que puedes hacerle ===== -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">

                        <!-- La tarjeta es EXACTAMENTE lo que vera alguien en su lista de servidores;
                             por eso no lleva cromo de la app dentro, salvo el lapiz. -->
                        <Border Grid.Column="0" Classes="mccard" Background="{StaticResource McListCard}"
                                BorderBrush="{StaticResource McListEdge}" BorderThickness="1"
                                CornerRadius="6" Padding="10" Margin="0,0,14,0"
                                VerticalAlignment="Center" HorizontalAlignment="Left"
                                MinWidth="260" MaxWidth="420">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Width="64" Height="64" ClipToBounds="True"
                                        Background="{StaticResource GroundWell}" CornerRadius="3">
                                    <Panel>
                                        <ic:SymbolIcon Symbol="Server" FontSize="28" Opacity="0.5"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       IsVisible="{Binding !HasIcon}" />
                                        <Image Source="{Binding ServerIcon}" Width="64" Height="64"
                                               RenderOptions.BitmapInterpolationMode="None"
                                               IsVisible="{Binding HasIcon}" />
                                    </Panel>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold"
                                               FontSize="16" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,3,0,0">
                                        <Border CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                                Background="{Binding ServerTypeBrush}">
                                            <TextBlock Text="{Binding ServerTypeText}" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="White" />
                                        </Border>
                                        <TextBlock Text="{Binding GameVersionText}" FontSize="12"
                                                   Foreground="{StaticResource McListText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock b:MinecraftMotd.Text="{Binding MotdText}" FontSize="13"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0"
                                               FontFamily="Cascadia Mono, Consolas, monospace" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Top"
                                            HorizontalAlignment="Right" Margin="10,0,0,0" Spacing="8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding PlayerCountText}" Foreground="{StaticResource McListText}"
                                                   FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                    ToolTip.Tip="{Binding SignalHint}">
                                            <Rectangle Width="3" Height="4" Fill="{Binding SignalBrush}" Margin="1,0,0,0" VerticalAlignment="Bottom" />
                                            <Rectangle Width="3" Height="6" Fill="{Binding SignalBrush}" Margin="1,0,0,0" VerticalAlignment="Bottom" />
                                            <Rectangle Width="3" Height="8" Fill="{Binding SignalBrush}" Margin="1,0,0,0" VerticalAlignment="Bottom" />
                                            <Rectangle Width="3" Height="10" Fill="{Binding SignalBrush}" Margin="1,0,0,0" VerticalAlignment="Bottom" />
                                            <Rectangle Width="3" Height="12" Fill="{Binding SignalBrush}" Margin="1,0,0,0" VerticalAlignment="Bottom" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- El lapiz. Unico cromo de la app dentro de la tarjeta, y esta
                                         callado hasta que te acercas. Editar lo que se ve pinchando
                                         encima de lo que se ve, en vez de buscar un boton dentro de
                                         un dialogo que ademas se llamaba otra cosa. -->
                                    <Button Classes="pencil" HorizontalAlignment="Right"
                                            ToolTip.Tip="{loc:Loc Motd_Title}"
                                            Command="{Binding DataContext.EditSignCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <ic:SymbolIcon Symbol="Edit" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Border HorizontalAlignment="Right" Margin="0,0,0,8" CornerRadius="10"
                                    Padding="10,3" Background="{StaticResource SurfaceChip}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Classes="statusdot" Classes.busy="{Binding IsBusy}"
                                             Width="10" Height="10" Fill="{Binding StatusBrush}"
                                             VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right"
                                        Margin="0,-4,2,8" IsVisible="{Binding HasIdleCountdown}"
                                        ToolTip.Tip="{loc:Loc Idle_CountdownHint}">
                                <ic:SymbolIcon Symbol="Timer" FontSize="13" Foreground="{StaticResource McListText}"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="{Binding IdleCountdownText}" FontSize="12"
                                           Foreground="{StaticResource McListText}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <!-- Los tres con su color y su nombre. Antes solo "Iniciar" llevaba
                                     etiqueta y los otros dos eran iconos sueltos del mismo gris: parar
                                     un servidor y reiniciarlo son cosas distintas y ninguna de las dos
                                     se distinguia de un vistazo. Verde, rojo y ambar es el reparto que
                                     ya usa la app para "va bien", "para" y "atencion". -->
                                <Button Classes="run go" Command="{Binding StartCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <ic:SymbolIcon Symbol="Play" Width="16" Height="16" />
                                        <TextBlock Text="{loc:Loc Start}" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="run stop" Command="{Binding StopCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <ic:SymbolIcon Symbol="Stop" Width="16" Height="16" />
                                        <TextBlock Text="{loc:Loc Stop}" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="run again" Command="{Binding RestartCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <ic:SymbolIcon Symbol="ArrowClockwise" Width="16" Height="16" />
                                        <TextBlock Text="{loc:Loc Restart}" />
                                    </StackPanel>
                                </Button>
                                <Button ToolTip.Tip="{loc:Loc Tip_OpenFolder}"
                                        Command="{Binding DataContext.OpenServerFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <ic:SymbolIcon Symbol="Folder" />
                                </Button>
                                <Button ToolTip.Tip="{loc:Loc Tip_Configure}"
                                        Command="{Binding DataContext.ConfigureServerCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <ic:SymbolIcon Symbol="Settings" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Arrancado y sin tunel: nadie de fuera puede entrar. -->
                    <Border Grid.Row="1" Margin="0,0,0,8" Padding="10,6" CornerRadius="6"
                            Background="{StaticResource SemanticDangerPanel}"
                            BorderBrush="{StaticResource SemanticDanger}" BorderThickness="1"
                            IsVisible="{Binding ShowTunnelWarning}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:SymbolIcon Symbol="Warning" Foreground="{StaticResource DangerIcon}" VerticalAlignment="Center" />
                            <TextBlock Foreground="{StaticResource DangerText}" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="{loc:Loc Signal_NoTunnel}" />
                        </StackPanel>
                    </Border>

                    <!-- ===== Piso 2: las medidas, a lo ancho =====
                         Cinco piezas y no siete: los dos puertos son una sola cosa, y las dos patas
                         del ping solo significan algo comparadas entre si — separarlas era pedirle a
                         quien mira que las juntase de cabeza. -->
                    <!-- Cada medida, una TARJETA con el icono a la izquierda: la etiqueta pequeña
                         encima del numero y, cuando la medida tiene serie, su minigrafico a la
                         derecha. Antes eran una tira de texto a media altura y el numero —que es lo
                         que se viene a mirar— era lo que menos se veia.

                         Sin medias, ni maximos, ni hora de inicio: eso habria que calcularlo y no se
                         pidio. Lo que hay aqui es lo que la app ya sabe.

                         Un ItemsControl con WrapPanel y no un WrapPanel a secas: asi las tarjetas
                         doblan solas cuando la ventana se estrecha, en vez de salirse. -->
                    <ItemsControl Grid.Row="2" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <Border Classes="mcard" Margin="0,0,8,8">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Classes="mcardIcon">
                                    <ic:SymbolIcon Symbol="Board" FontSize="17" Width="18" Height="18" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="CPU" Classes="mcardLabel" />
                                    <TextBlock Text="{Binding CpuText}" Classes="metricValue" />
                                </StackPanel>
                                <controls:Sparkline Grid.Column="2" Width="46" Height="20"
                                                    VerticalAlignment="Center" Margin="10,0,0,0"
                                                    Values="{Binding CpuSeries}" MaxValue="100"
                                                    Stroke="{StaticResource SemanticOk}" />
                            </Grid>
                        </Border>

                        <Border Classes="mcard" Margin="0,0,8,8">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Classes="mcardIcon">
                                    <ic:SymbolIcon Symbol="Server" FontSize="17" Width="18" Height="18" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="RAM" Classes="mcardLabel" />
                                    <TextBlock Text="{Binding RamText}" Classes="metricValue" />
                                </StackPanel>
                                <controls:Sparkline Grid.Column="2" Width="46" Height="20"
                                                    VerticalAlignment="Center" Margin="10,0,0,0"
                                                    Values="{Binding RamSeries}"
                                                    Stroke="{StaticResource SparklineRam}" />
                            </Grid>
                        </Border>

                        <Border Classes="mcard" Margin="0,0,8,8">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Classes="mcardIcon">
                                    <ic:SymbolIcon Symbol="Timer" FontSize="17" Width="18" Height="18" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc Uptime}" Classes="mcardLabel" />
                                    <TextBlock Text="{Binding UptimeText}" Classes="metricValue" />
                                </StackPanel>
                            </Grid>
                        </Border>


                        <Border Classes="mcard" Margin="0,0,8,8" IsVisible="{Binding HasPing}" ToolTip.Tip="{loc:Loc Ping_Disclaimer}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Classes="mcardIcon">
                                    <ic:SymbolIcon Symbol="WifiWarning" FontSize="17" Width="18" Height="18" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Ping" Classes="mcardLabel" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding PingDirectText}" Classes="metricValue"
                                                   Foreground="{Binding PingDirectBrush}" />
                                        <TextBlock Text="/" Classes="metricSep" />
                                        <TextBlock Text="{Binding PingTunnelText}" Classes="metricValue"
                                                   Foreground="{Binding PingTunnelBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ItemsControl>

                    <!-- El veredicto del ping, en su propia linea y solo cuando hay algo que decir.
                         Probe a meterlo en la tira, al lado del ping del que sale: no cabe. Medido,
                         las cinco medidas con sus margenes son 615 px y el veredicto otros 239, o
                         sea 854 contra los 782 disponibles — la tira doblaba entera por meterle una
                         frase. Aqui cuesta 19 px, y solo cuando el ping tiene un veredicto. -->
                    <TextBlock Grid.Row="3" Text="{Binding PingVerdictText}"
                               IsVisible="{Binding HasPingVerdict}"
                               FontSize="11.5" Opacity="0.75" TextWrapping="Wrap"
                               Margin="2,0,2,8" />

                    <!-- ===== Piso 3: las direcciones =====
                         Pastillas que copian al pulsarlas, no cajas de texto de solo lectura: lo que
                         se hace con una direccion es mandarsela a alguien. Las DOS, porque un
                         servidor con crossplay tiene dos distintas y quien entra desde Bedrock
                         necesita la suya. -->
                    <!-- Un WrapPanel a secas y no un Grid: la primera version puso esto en una
                         columna `Auto`, y una columna Auto mide a lo ancho INFINITO — asi que el
                         WrapPanel no doblaba nunca y a 900 px las pastillas se salian por la
                         derecha, con los dos botones fuera de la ventana. Aqui dobla porque tiene
                         un ancho de verdad contra el que medirse. El veredicto va dentro, como una
                         pieza mas, para que doble con todo lo demas en vez de aparte. -->
                    <WrapPanel Grid.Row="4" Margin="0,0,0,8"
                               IsVisible="{Binding HasTunnelAddress}">
                        <Button Classes="addrpill" Command="{Binding CopyTunnelAddressCommand}"
                                    ToolTip.Tip="{loc:Loc Copy}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Java" Classes="addrKey" />
                                    <TextBlock Text="{Binding TunnelAddress}" Classes="addrValue" />
                                    <ic:SymbolIcon Symbol="Copy" FontSize="13" Opacity="0.55" />
                                </StackPanel>
                            </Button>

                        <Button Classes="addrpill" IsVisible="{Binding HasBedrockAddress}"
                                    Command="{Binding CopyBedrockForSharingCommand}"
                                    ToolTip.Tip="{loc:Loc Addr_Share}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Bedrock" Classes="addrKey" />
                                    <TextBlock Text="{Binding BedrockHost}" Classes="addrValue" />
                                    <TextBlock Text=":" Classes="addrKey" Margin="-4,0,-4,0" />
                                    <TextBlock Text="{Binding BedrockPortText}" Classes="addrValue" />
                                    <ic:SymbolIcon Symbol="Share" FontSize="13" Opacity="0.55" />
                                </StackPanel>
                            </Button>

                            <!-- Dos botones porque son dos tareas: el cliente de Bedrock pide la
                                 direccion y el puerto en casillas separadas y no traga "host:puerto",
                                 pero lo primero que se hace es mandarle las dos a alguien. -->
                        <Button Classes="addrpill icon" IsVisible="{Binding HasBedrockAddress}"
                                Command="{Binding CopyBedrockAddressCommand}"
                                ToolTip.Tip="{loc:Loc Addr_CopyHost}">
                            <ic:SymbolIcon Symbol="Copy" FontSize="13" Width="16" Height="16" />
                        </Button>

                        <!-- Los puertos LOCALES viven aqui y no en una tarjeta: hablan de lo mismo
                             que las direcciones —por donde se entra— y como tarjeta obligaban a las
                             otras cuatro a doblar de fila. Medido: cinco tarjetas piden ~890 px de
                             los 804 que hay. No es un boton porque no hay nada que copiar: el puerto
                             local no le sirve a nadie de fuera de este equipo. -->
                        <Border Classes="portpill" ToolTip.Tip="{loc:Loc Crossplay_BedrockPort}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="addrKey" IsVisible="{Binding !IsCrossplayOn}"
                                           Text="{loc:Loc Port}" />
                                <TextBlock Classes="addrKey" IsVisible="{Binding IsCrossplayOn}"
                                           Text="{loc:Loc Ports}" />
                                <TextBlock Text="{Binding PortText}" Classes="addrValue" />
                                <TextBlock Text="/" Classes="addrKey" IsVisible="{Binding IsCrossplayOn}" />
                                <TextBlock Text="{Binding BedrockLocalPortText}" Classes="addrValue"
                                           IsVisible="{Binding IsCrossplayOn}" />
                            </StackPanel>
                        </Border>

                        <!-- Aqui habia un boton de "ir a Tuneles". Sobraba: el rail tiene esa
                             seccion a un clic y siempre visible, asi que era un segundo camino al
                             mismo sitio ocupando sitio en la unica fila que no cabia — medido, las
                             pastillas pedian 824 px de los 804 que hay. -->
                    </WrapPanel>

                    <!-- Tabs: Console / Players / Mods / Backups -->
                    <TabControl Grid.Row="5" Classes="slim" x:Name="ServerTabs" Background="Transparent" Margin="0">
                        <TabItem>
                            <!-- El icono lleva Width y Height a proposito. Sin ellos un
                                 SymbolIcon se mide con lo que le den: medido, la cabecera se
                                 quedaba con TODO el alto del TabControl y el panel de la
                                 pestaña bajaba a CERO — la consola no se dibujaba. Es el mismo
                                 fallo que ya tuvieron los botones de icono de las direcciones. -->
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <ic:SymbolIcon Symbol="Code" FontSize="15" Width="16" Height="16" />
                                    <TextBlock Text="{loc:Loc Console}" />
                                </StackPanel>
                            </TabItem.Header>
                            <!-- El margen superior lo lleva la raiz de la propia vista, no esta etiqueta: ponerlo
                                 aqui tambien lo aplicaria dos veces. -->
                            <views:ServerConsoleView />
                        </TabItem>

                        <TabItem>
                            <!-- El icono lleva Width y Height a proposito. Sin ellos un
                                 SymbolIcon se mide con lo que le den: medido, la cabecera se
                                 quedaba con TODO el alto del TabControl y el panel de la
                                 pestaña bajaba a CERO — la consola no se dibujaba. Es el mismo
                                 fallo que ya tuvieron los botones de icono de las direcciones. -->
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <ic:SymbolIcon Symbol="People" FontSize="15" Width="16" Height="16" />
                                    <TextBlock Text="{loc:Loc Players}" />
                                </StackPanel>
                            </TabItem.Header>
                            <views:ServerPlayersView />
                        </TabItem>

                        <TabItem IsVisible="{Binding IsModded}">
                            <!-- El icono lleva Width y Height a proposito. Sin ellos un
                                 SymbolIcon se mide con lo que le den: medido, la cabecera se
                                 quedaba con TODO el alto del TabControl y el panel de la
                                 pestaña bajaba a CERO — la consola no se dibujaba. Es el mismo
                                 fallo que ya tuvieron los botones de icono de las direcciones. -->
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <ic:SymbolIcon Symbol="PuzzlePiece" FontSize="15" Width="16" Height="16" />
                                    <TextBlock Text="{Binding Mods.ContentTabTitle}" />
                                </StackPanel>
                            </TabItem.Header>
                            <ContentControl Content="{Binding Mods}">
                                <ContentControl.DataTemplates>
                                    <DataTemplate DataType="vm:ServerModsViewModel">
                                        <views:ServerModsView />
                                    </DataTemplate>
                                </ContentControl.DataTemplates>
                            </ContentControl>
                        </TabItem>

                        <TabItem>
                            <!-- El icono lleva Width y Height a proposito. Sin ellos un
                                 SymbolIcon se mide con lo que le den: medido, la cabecera se
                                 quedaba con TODO el alto del TabControl y el panel de la
                                 pestaña bajaba a CERO — la consola no se dibujaba. Es el mismo
                                 fallo que ya tuvieron los botones de icono de las direcciones. -->
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <ic:SymbolIcon Symbol="Archive" FontSize="15" Width="16" Height="16" />
                                    <TextBlock Text="{loc:Loc Backups}" />
                                </StackPanel>
                            </TabItem.Header>
                            <ContentControl Content="{Binding Backups}">
                                <ContentControl.DataTemplates>
                                    <DataTemplate DataType="vm:ServerBackupsViewModel">
                                        <views:ServerBackupsView />
                                    </DataTemplate>
                                </ContentControl.DataTemplates>
                            </ContentControl>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Panel>
            </Grid>
        </Grid>
    </Grid>
</Window>
