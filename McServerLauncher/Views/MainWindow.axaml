<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="using:McServerLauncher.Behaviors"
        xmlns:loc="using:McServerLauncher.Localization"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:views="using:McServerLauncher.Views"
        xmlns:vm="using:McServerLauncher.ViewModels"
        xmlns:controls="using:McServerLauncher.Controls"
        x:Class="McServerLauncher.Views.MainWindow"
        x:CompileBindings="False"
        Title="MC Server Launcher"
        Icon="/Resources/app.ico"
        Width="1150" Height="720"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- Un interruptor de categoria: pequeno, para que quepan siete sin empujar nada. -->
        <Style Selector="ToggleButton.kindchip">
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0,0,4,2" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <!-- Apagado se ve claramente apagado: un filtro que no se nota es un filtro que te hace
             pensar que el servidor no dice nada. -->
        <Style Selector="ToggleButton.kindchip:not(:checked)">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <!-- Compact rows for the console list -->
        <Style Selector="ListBox.console ListBoxItem">
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- El rail: icono encima, etiqueta debajo. La seccion activa lleva una barra a la izquierda y
             la opacidad plena; las demas, apagadas. Nada se mide ni se anima: la barra es un borde
             que aparece o no, asi no hay posiciones que se desajusten al cambiar el tamano de letra. -->
        <Style Selector="Button.rail">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0,9" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Opacity" Value="0.62" />
        </Style>
        <Style Selector="Button.rail:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.rail:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceCard}" />
        </Style>
        <Style Selector="Button.rail.on">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.rail TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- «+ Nuevo»: el unico boton de la app con borde y texto de acento, para que no se confunda
             con ningun otro. Se rellena del azul de los botones principales al pasar el raton. -->
        <Style Selector="Button.newserver">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentSelected}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource AccentSelected}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.newserver:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
        </Style>
        <Style Selector="Button.newserver:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPressed}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBackgroundPressed}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundPressed}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Update-available banner -->
        <Border Grid.Row="0" Background="{StaticResource SemanticInfo}" Padding="14,8" IsVisible="{Binding UpdateAvailable}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <ic:SymbolIcon Grid.Column="0" Symbol="ArrowDownload" Foreground="White"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding UpdateText}" Foreground="White" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="{loc:Loc Update_Now}" Margin="0,0,8,0" Command="{Binding UpdateNowCommand}" />
                <Button Grid.Column="3" Background="Transparent" Foreground="White"
                        Command="{Binding DismissUpdateCommand}" ToolTip.Tip="{loc:Loc Tip_Hide}">
                    <ic:SymbolIcon Symbol="Dismiss" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="72,*">

            <!-- Rail: which part of the app is on screen. One accent bar for the whole rail, sliding
                 to the section on screen (Controls/SelectionMarker, over the buttons in the same cell). -->
            <Border Grid.Column="0" Background="{StaticResource GroundPopup}">
                <Panel>
                <Grid x:Name="RailItems" RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,8">
                    <Button Grid.Row="0" Classes="rail" Classes.on="{Binding IsServersSection}"
                            Command="{Binding ShowServersCommand}" ToolTip.Tip="{loc:Loc Servers}">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                <ic:SymbolIcon Symbol="Server" FontSize="20" HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Loc Servers}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Row="1" Classes="rail" Classes.on="{Binding IsTunnelsSection}"
                            Command="{Binding ShowTunnelsCommand}" ToolTip.Tip="{loc:Loc Nav_Tunnels}">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                <ic:SymbolIcon Symbol="Globe" FontSize="20" HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Loc Nav_Tunnels}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Row="3" Classes="rail" Classes.on="{Binding IsSettingsSection}"
                            Command="{Binding ShowSettingsCommand}" ToolTip.Tip="{loc:Loc Settings_Title}">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                <ic:SymbolIcon Symbol="Settings" FontSize="20" HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Loc Settings_Title}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Row="4" Classes="rail" Classes.on="{Binding IsAboutSection}"
                            Command="{Binding ShowAboutCommand}" ToolTip.Tip="{loc:Loc Nav_About}">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center" Spacing="3">
                                <ic:SymbolIcon Symbol="Info" FontSize="20" HorizontalAlignment="Center" />
                                <TextBlock Text="{loc:Loc Nav_About}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </Grid>
                <controls:SelectionMarker Host="{Binding #RailItems}" Shape="Bar" />
                </Panel>
            </Border>

            <!-- Sections share one cell and stay mounted: switching is IsVisible, so the console keeps
                 its scroll and its lines instead of being rebuilt every time. -->
            <Grid Grid.Column="1" ColumnDefinitions="290,*" IsVisible="{Binding IsServersSection}" Classes="fadein">

            <!-- Side panel: server list -->
            <Border Grid.Column="0" Background="{StaticResource GroundSidebar}" Padding="12">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,0,0,10">
                        <TextBlock Text="{loc:Loc Servers}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <!-- Crear o añadir: un solo boton, que abre el panel de nuevo servidor. El halo
                             de detras y el destello de encima son su aviso periodico (Motion.axaml); el
                             punto dice que hay uno a medias esperando. -->
                        <Panel Grid.Column="1" Classes="newserver" Classes.quiet="{Binding IsCreatingServer}"
                               b:BeaconBehavior.IsEnabled="True"
                               VerticalAlignment="Center">
                            <Border Classes="halo" CornerRadius="8" Background="Transparent" IsHitTestVisible="False" />
                            <Button Classes="newserver" Command="{Binding ShowNewServerCommand}"
                                    ToolTip.Tip="{Binding NewServerTip}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <ic:SymbolIcon Symbol="Add" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Loc New_Button}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border CornerRadius="8" ClipToBounds="True" IsHitTestVisible="False">
                                <Border Classes="shine" Width="28" HorizontalAlignment="Left"
                                        Background="{StaticResource ShimmerSweep}">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="-40" />
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentSelected}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"
                                     IsHitTestVisible="False" IsVisible="{Binding HasNewServerDraft}" />
                        </Panel>
                    </Grid>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Servers}"
                             SelectedItem="{Binding SelectedServer}"
                             Background="Transparent"
                             HorizontalAlignment="Stretch"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,6" ColumnDefinitions="Auto,*,Auto">
                                    <!-- Status dot with a colored halo -->
                                    <Panel Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Ellipse Fill="{Binding StatusBrush}" Opacity="0.25" />
                                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Panel>

                                    <StackPanel Grid.Column="1">
                                        <controls:MarqueeText Text="{Binding Name}" TextElement.FontWeight="SemiBold" TextElement.FontSize="14" />
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                            <Border CornerRadius="4" Padding="5,1" VerticalAlignment="Center"
                                                    Background="{Binding ServerTypeBrush}">
                                                <TextBlock Text="{Binding ServerTypeText}" FontSize="10"
                                                           FontWeight="SemiBold" Foreground="White" />
                                            </Border>
                                            <TextBlock Text="{Binding StatusText}" FontSize="12"
                                                       Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Connected players when running, and the row's own actions: they
                                         fade in with the pointer over the row or with it selected. -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding PlayerCountText}" FontSize="12"
                                                   Foreground="{Binding SignalBrush}" VerticalAlignment="Center"
                                                   Margin="6,0,4,0" IsVisible="{Binding IsRunning}" />
                                        <StackPanel Classes="rowactions" Orientation="Horizontal" Spacing="2">
                                            <Button Classes="rowaction"
                                                    Command="{Binding DataContext.EditServerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="{loc:Loc Tip_Edit}">
                                                <ic:SymbolIcon Symbol="Edit" FontSize="15" />
                                            </Button>
                                            <Button Classes="rowaction danger"
                                                    Command="{Binding DataContext.RemoveServerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="{loc:Loc Tip_Delete}">
                                                <ic:SymbolIcon Symbol="Delete" FontSize="15" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Grid>
            </Border>

            <!-- Main panel: selected server detail -->
            <Panel Grid.Column="1" Margin="16">
                <TextBlock Text="{loc:Loc EmptyState}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="16" Opacity="0.6"
                           IsVisible="{Binding ShowEmptyState}" />

                <Grid DataContext="{Binding SelectedServer}"
                      RowDefinitions="Auto,Auto,Auto,*"
                      IsVisible="{Binding DataContext.ShowServerDetail, RelativeSource={RelativeSource AncestorType=Window}}">

                    <!-- Header: name + control buttons -->
                    <Grid Grid.Row="0" Margin="0,0,0,12" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                        <!-- Minecraft server-list style view (the same control the appearance editor previews with) -->
                        <views:ServerCardView Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center"
                                              IsEditable="True"
                                              EditCommand="{Binding DataContext.EditAppearanceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Icon="{Binding ServerIcon}"
                                              ServerName="{Binding Name}"
                                              TypeText="{Binding ServerTypeText}"
                                              TypeBrush="{Binding ServerTypeBrush}"
                                              Version="{Binding GameVersionText}"
                                              Motd="{Binding MotdText}"
                                              PlayerCount="{Binding PlayerCountText}"
                                              SignalBrush="{Binding SignalBrush}"
                                              SignalHint="{Binding SignalHint}" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Border HorizontalAlignment="Right" Margin="0,0,0,8" CornerRadius="10" Padding="10,3" Background="{StaticResource SurfaceChip}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Only while the empty-server clock is actually running (HasIdleCountdown). -->
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right"
                                        Margin="0,-4,2,8" IsVisible="{Binding HasIdleCountdown}"
                                        ToolTip.Tip="{loc:Loc Idle_CountdownHint}">
                                <ic:SymbolIcon Symbol="Timer" FontSize="13" Foreground="{StaticResource McListText}"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="{Binding IdleCountdownText}" FontSize="12"
                                           Foreground="{StaticResource McListText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                <Button Classes="accent" Command="{Binding StartCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ic:SymbolIcon Symbol="Play" />
                                        <TextBlock Text="{loc:Loc Start}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding StopCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ic:SymbolIcon Symbol="Stop" />
                                        <TextBlock Text="{loc:Loc Stop}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RestartCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ic:SymbolIcon Symbol="ArrowClockwise" />
                                        <TextBlock Text="{loc:Loc Restart}" />
                                    </StackPanel>
                                </Button>
                                <Button ToolTip.Tip="{loc:Loc Tip_Configure}"
                                        Command="{Binding DataContext.ConfigureServerCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ic:SymbolIcon Symbol="Settings" />
                                        <TextBlock Text="{loc:Loc Configure}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Warning: running but without a Playit tunnel -->
                        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Padding="10,6"
                                CornerRadius="6" Background="{StaticResource SemanticDangerPanel}" BorderBrush="{StaticResource SemanticDanger}" BorderThickness="1"
                                IsVisible="{Binding ShowTunnelWarning}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ic:SymbolIcon Symbol="Warning" Foreground="{StaticResource DangerIcon}" VerticalAlignment="Center" />
                                <TextBlock Foreground="{StaticResource DangerText}" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Text="{loc:Loc Signal_NoTunnel}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Status cards -->
                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,8">
                        <Border Classes="card stat">
                            <StackPanel>
                                <TextBlock Text="CPU" Classes="statLabel" />
                                <TextBlock Text="{Binding CpuText}" Classes="statValue" />
                                <controls:Sparkline Height="22" Margin="0,4,0,0"
                                                    Values="{Binding CpuSeries}" MaxValue="100"
                                                    Stroke="{StaticResource SemanticOk}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card stat">
                            <StackPanel>
                                <TextBlock Text="RAM" Classes="statLabel" />
                                <TextBlock Text="{Binding RamText}" Classes="statValue" />
                                <controls:Sparkline Height="22" Margin="0,4,0,0"
                                                    Values="{Binding RamSeries}"
                                                    Stroke="{StaticResource SparklineRam}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card stat">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Uptime}" Classes="statLabel" />
                                <TextBlock Text="{Binding UptimeText}" Classes="statValue" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card stat">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Port}" Classes="statLabel" />
                                <TextBlock Text="{Binding PortText}" Classes="statValue" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Playit.gg: only where players connect. Managing the account and its tunnels
                         lives in the Tunnels section; this is what you copy and send to a friend. -->
                    <Border Grid.Row="2" Classes="card stat" Margin="4,4,4,12">
                      <StackPanel>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Playit.gg" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PlayitStatusText}" FontSize="12" Opacity="0.7" />
                            </StackPanel>
                            <TextBox Grid.Column="1" Margin="16,0" Text="{Binding TunnelAddress}" IsReadOnly="True"
                                     Watermark="{loc:Loc Tunnel_None}" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Command="{Binding CopyTunnelAddressCommand}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:SymbolIcon Symbol="Copy" />
                                    <TextBlock Text="{loc:Loc Copy}" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" ToolTip.Tip="{loc:Loc Tip_ManageTunnels}"
                                    Command="{Binding DataContext.ShowTunnelsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:SymbolIcon Symbol="Globe" />
                                    <TextBlock Text="{loc:Loc Nav_Tunnels}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <!-- Bedrock: host and port in separate boxes, because that is how the
                             Bedrock client asks for them. There is no SRV record for Bedrock, so
                             pasting "host:port" into its address field simply fails. -->
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,10,0,0"
                              IsVisible="{Binding HasBedrockAddress}">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"
                                       Text="{loc:Loc Crossplay_BedrockAddress}" />
                            <TextBox Grid.Column="1" Margin="16,0,8,0" IsReadOnly="True"
                                     Text="{Binding BedrockHost}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Opacity="0.7" Text="{loc:Loc Crossplay_BedrockPort}" />
                            <TextBox Grid.Column="3" Width="90" Margin="0,0,8,0" IsReadOnly="True"
                                     Text="{Binding BedrockPortText}" VerticalAlignment="Center" />
                            <Button Grid.Column="4" Command="{Binding CopyBedrockAddressCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:SymbolIcon Symbol="Copy" />
                                    <TextBlock Text="{loc:Loc Copy}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <!-- The local port and the state show whenever crossplay is on, not only
                             once a tunnel lookup has succeeded. The port is known from the moment
                             Geyser is set up, and it is what works on this network; the line under
                             it says why there is no public address yet, instead of leaving the
                             whole block invisible and the server looking broken. -->
                        <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,10,0,0"
                              IsVisible="{Binding IsCrossplayOn}">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Opacity="0.7"
                                       Text="{loc:Loc Crossplay_LocalPort}" />
                            <TextBox Grid.Column="1" Width="90" Margin="8,0,0,0" IsReadOnly="True"
                                     Text="{Binding BedrockLocalPortText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                                       FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                       Text="{Binding BedrockStateText}" />
                        </Grid>
                        <TextBlock IsVisible="{Binding HasBedrockAddress}" FontSize="11" Opacity="0.55"
                                   TextWrapping="Wrap" Margin="4,4,4,0"
                                   Text="{loc:Loc Crossplay_BedrockHint}" />
                      </StackPanel>
                    </Border>

                    <!-- Tabs: Console / Players / Mods. One underline for the whole strip, sliding
                         to the picked tab (Controls/TabUnderline), drawn over it in the same cell. -->
                    <Panel Grid.Row="3">
                    <controls:TabUnderline Tabs="{Binding #ServerTabs}" ZIndex="1" />
                    <TabControl x:Name="ServerTabs" Background="Transparent" Margin="4,0">
                        <TabItem Header="{loc:Loc Console}">
                            <Grid Margin="0,8,0,0" RowDefinitions="*,Auto">
                                <!-- Console -->
                                <Border Grid.Row="0" Classes="card stat" Margin="0" Padding="0">
                                    <Grid RowDefinitions="Auto,*">
                                        <Grid Grid.Row="0" Margin="12,8" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                            <TextBlock Grid.Column="0" Text="{loc:Loc Console}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <!-- Un interruptor por categoria, con su cuenta al lado. La cuenta es lo que
                                                 los hace servir para vigilar y no solo para buscar: «Errores 3» se ve sin
                                                 pulsar nada. En un WrapPanel para que al estrechar la ventana bajen de
                                                 linea en vez de empujar la caja de busqueda fuera de la pantalla. -->
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding ConsoleKinds}" Margin="12,0,8,0"
                                                          VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ToggleButton Classes="kindchip" IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                                      ToolTip.Tip="{Binding Tip}">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                                         Fill="{Binding Brush}" />
                                                                <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Count}" FontSize="11" Opacity="0.6"
                                                                           VerticalAlignment="Center" />
                                                                <!-- Llego algo de este tipo mientras estaba apagado. Sin esto
                                                                     seria del todo invisible: fuera de la lista y sin nada
                                                                     en pantalla que cambie. -->
                                                                <Ellipse Width="6" Height="6" VerticalAlignment="Top" Margin="0,1,0,0"
                                                                         Fill="{StaticResource SemanticWarn}"
                                                                         IsVisible="{Binding HasUnseen}" />
                                                            </StackPanel>
                                                        </ToggleButton>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBox Grid.Column="2" Width="200" Margin="0,0,8,0" Padding="8,4"
                                                     Text="{Binding ConsoleFilter, Mode=TwoWay}"
                                                     Watermark="{loc:Loc Console_FilterPlaceholder}" />
                                            <Button Grid.Column="3" Margin="0,0,8,0" Padding="8,2" VerticalAlignment="Center"
                                                    Command="{Binding ShowAllConsoleKindsCommand}"
                                                    IsVisible="{Binding IsConsoleFiltered}"
                                                    Content="{loc:Loc Console_ShowAll}" />
                                            <Button Grid.Column="4" Command="{Binding ClearConsoleCommand}" Padding="8,2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <ic:SymbolIcon Symbol="Eraser" />
                                                    <TextBlock Text="{loc:Loc Clear}" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <ListBox Grid.Row="1" x:Name="ConsoleList" Classes="console"
                                                 ItemsSource="{Binding VisibleConsoleLines}"
                                                 b:AutoScrollBehavior.AutoScroll="True"
                                                 FontFamily="Cascadia Mono, Consolas, monospace"
                                                 FontSize="12" Background="{StaticResource GroundPopup}" BorderThickness="0"
                                                 Padding="0,0,0,4" SelectionMode="Multiple"
                                                 KeyDown="ConsoleList_KeyDown"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{loc:Loc Copy_Selection}" Click="ConsoleCopy_Click" />
                                                    <MenuItem Header="{loc:Loc Copy_All}" Click="ConsoleCopyAll_Click" />
                                                </ContextMenu>
                                            </ListBox.ContextMenu>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- El color sale de la categoria a traves de un converter, no de un
                                                         pincel guardado en cada linea: hay dos mil, y un color que cambies
                                                         en Ajustes tiene que llegar a todas sin recorrerlas. Inlines en vez
                                                         de Text para poder marcar dentro de la linea lo que buscas. -->
                                                    <TextBlock TextWrapping="Wrap"
                                                               Foreground="{Binding Kind, Converter={x:Static vm:ConsoleBrushConverter.Instance}}">
                                                        <TextBlock.Inlines>
                                                            <MultiBinding Converter="{x:Static vm:ConsoleHighlightConverter.Instance}">
                                                                <Binding Path="Text" />
                                                                <Binding Path="DataContext.ConsoleFilter"
                                                                         RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                                            </MultiBinding>
                                                        </TextBlock.Inlines>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>

                                <!-- Command box -->
                                <Grid Grid.Row="1" Margin="0,12,0,0" ColumnDefinitions="*,Auto,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding CommandText}"
                                             Watermark="{loc:Loc Command_Placeholder}" Margin="0,0,8,0">
                                        <TextBox.KeyBindings>
                                            <KeyBinding Gesture="Enter" Command="{Binding SendCommandCommand}" />
                                        </TextBox.KeyBindings>
                                    </TextBox>

                                    <!-- Command help -->
                                    <ToggleButton Grid.Column="1" x:Name="CommandHelpToggle" Margin="0,0,8,0"
                                                  IsChecked="{Binding IsCommandHelpOpen, Mode=TwoWay}"
                                                  ToolTip.Tip="{loc:Loc Tip_Commands}" Padding="10,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <ic:SymbolIcon Symbol="QuestionCircle" />
                                            <TextBlock Text="{loc:Loc Commands}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>

                                    <Popup PlacementTarget="{Binding #CommandHelpToggle}" Placement="Top"
                                           IsOpen="{Binding IsCommandHelpOpen, Mode=TwoWay}" IsLightDismissEnabled="True"
                                           HorizontalOffset="0" VerticalOffset="-6">
                                        <Border Background="{StaticResource GroundPopup}" BorderBrush="{StaticResource SurfaceEdgeStrong}" BorderThickness="1"
                                                CornerRadius="8" Width="460" MaxHeight="380" Padding="6">
                                            <Grid RowDefinitions="Auto,*">
                                                <TextBlock Grid.Row="0" Margin="8,6,8,8" Opacity="0.8" TextWrapping="Wrap"
                                                           Text="{loc:Loc Cmd_HelpIntro}" />
                                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding CommandHelp}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Margin="2"
                                                                        Background="Transparent" BorderThickness="0" Padding="8,6"
                                                                        Command="{Binding DataContext.UseCommandCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}">
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                                   FontFamily="Cascadia Mono, Consolas, monospace" />
                                                                        <TextBlock Text="{Binding Description}" FontSize="12"
                                                                                   Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </Popup>

                                    <Button Grid.Column="2" Classes="accent" Command="{Binding SendCommandCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <ic:SymbolIcon Symbol="Send" />
                                            <TextBlock Text="{loc:Loc Send}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="{loc:Loc Players}">
                            <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Grid Margin="4,0,4,8">
                                        <TextBlock Text="{loc:Loc Players_Manage}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                        <Button HorizontalAlignment="Right" Padding="8,2" Command="{Binding RefreshPlayersCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <ic:SymbolIcon Symbol="ArrowClockwise" />
                                                <TextBlock Text="{loc:Loc Refresh}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Connected -->
                                    <Border Classes="card stat">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontWeight="SemiBold" Text="{loc:Loc Players_Connected}" />
                                                <TextBlock FontWeight="SemiBold" Text="{Binding ConnectedPlayers.Count, StringFormat=' ({0})'}" />
                                            </StackPanel>
                                            <TextBlock Classes="statLabel" Text="{loc:Loc Players_ConnectedHint}" />
                                            <ItemsControl ItemsSource="{Binding ConnectedPlayers}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3" ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                                <Button Content="OP" Padding="8,2"
                                                                        Command="{Binding DataContext.OpPlayerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Content="{loc:Loc Kick}" Padding="8,2"
                                                                        Command="{Binding DataContext.KickPlayerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Content="{loc:Loc Ban}" Padding="8,2" Background="{StaticResource DangerButton}" Foreground="White"
                                                                        Command="{Binding DataContext.BanPlayerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Operators -->
                                    <Border Classes="card stat">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontWeight="SemiBold" Text="{loc:Loc Players_Ops}" />
                                                <TextBlock FontWeight="SemiBold" Text="{Binding OpPlayers.Count, StringFormat=' ({0})'}" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding OpPlayers}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3" ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" />
                                                            <Button Grid.Column="1" Content="{loc:Loc RemoveOp}" Padding="8,2"
                                                                    Command="{Binding DataContext.DeopPlayerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Whitelist -->
                                    <Border Classes="card stat">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontWeight="SemiBold" Text="{loc:Loc Players_Whitelist}" />
                                                <TextBlock FontWeight="SemiBold" Text="{Binding WhitelistPlayers.Count, StringFormat=' ({0})'}" />
                                            </StackPanel>
                                            <TextBlock Classes="statLabel" Text="{loc:Loc Whitelist_Hint}" />
                                            <Grid Margin="0,8,0,8" ColumnDefinitions="*,Auto">
                                                <TextBox Grid.Column="0" Margin="0,0,8,0" Text="{Binding NewWhitelistName}"
                                                         Watermark="{loc:Loc Player_Placeholder}">
                                                    <TextBox.KeyBindings>
                                                        <KeyBinding Gesture="Enter" Command="{Binding AddToWhitelistCommand}" />
                                                    </TextBox.KeyBindings>
                                                </TextBox>
                                                <Button Grid.Column="1" Classes="accent" Command="{Binding AddToWhitelistCommand}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <ic:SymbolIcon Symbol="PersonAdd" />
                                                        <TextBlock Text="{loc:Loc Add}" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding WhitelistPlayers}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3" ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" />
                                                            <Button Grid.Column="1" Content="{loc:Loc Remove}" Padding="8,2"
                                                                    Command="{Binding DataContext.RemoveFromWhitelistCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Banned -->
                                    <Border Classes="card stat">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontWeight="SemiBold" Text="{loc:Loc Players_Banned}" />
                                                <TextBlock FontWeight="SemiBold" Text="{Binding BannedPlayers.Count, StringFormat=' ({0})'}" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding BannedPlayers}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3" ColumnDefinitions="*,Auto">
                                                            <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" />
                                                            <Button Grid.Column="1" Content="{loc:Loc Unban}" Padding="8,2"
                                                                    Command="{Binding DataContext.PardonPlayerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Known -->
                                    <Border Classes="card stat">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontWeight="SemiBold" Text="{loc:Loc Players_Known}" />
                                                <TextBlock FontWeight="SemiBold" Text="{Binding KnownPlayers.Count, StringFormat=' ({0})'}" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding KnownPlayers}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Margin="0,3" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem IsVisible="{Binding IsModded}">
                            <!-- "Mods" or "Plugins" depending on the server, always as wide as the
                                 longer of the two: the hidden copies hold the width, so switching
                                 between a Paper and a Fabric server no longer shifts the tabs after it. -->
                            <TabItem.Header>
                                <Panel>
                                    <TextBlock Text="{loc:Loc Mods}" Opacity="0" />
                                    <TextBlock Text="{loc:Loc Plugins}" Opacity="0" />
                                    <TextBlock Text="{Binding Mods.ContentTabTitle}" HorizontalAlignment="Center" />
                                </Panel>
                            </TabItem.Header>
                            <ContentControl Content="{Binding Mods}">
                                <ContentControl.DataTemplates>
                                    <DataTemplate DataType="vm:ServerModsViewModel">
                                        <views:ServerModsView />
                                    </DataTemplate>
                                </ContentControl.DataTemplates>
                            </ContentControl>
                        </TabItem>

                        <TabItem Header="{loc:Loc Backups}">
                            <ContentControl Content="{Binding Backups}">
                                <ContentControl.DataTemplates>
                                    <DataTemplate DataType="vm:ServerBackupsViewModel">
                                        <views:ServerBackupsView />
                                    </DataTemplate>
                                </ContentControl.DataTemplates>
                            </ContentControl>
                        </TabItem>
                    </TabControl>
                    </Panel>
                </Grid>

                <!-- Nuevo servidor: ocupa el detalle mientras se crea o se añade uno. -->
                <ContentControl Content="{Binding NewServerPanel}" IsVisible="{Binding IsCreatingServer}" Classes="fadein" />
            </Panel>
            </Grid>

            <Panel Grid.Column="1" IsVisible="{Binding IsTunnelsSection}" Classes="fadein">
                <views:TunnelsView DataContext="{Binding Tunnels}" />
            </Panel>

            <Panel Grid.Column="1" IsVisible="{Binding IsSettingsSection}" Classes="fadein">
                <views:SettingsView DataContext="{Binding Settings}" />
            </Panel>

            <Panel Grid.Column="1" IsVisible="{Binding IsAboutSection}" Classes="fadein">
                <views:AboutView />
            </Panel>
        </Grid>
    </Grid>
</Window>
