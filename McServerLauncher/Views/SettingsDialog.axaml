<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:McServerLauncher.Localization"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:vm="using:McServerLauncher.ViewModels"
        x:Class="McServerLauncher.Views.SettingsDialog"
        x:CompileBindings="False"
        Title="{loc:Loc Settings_Title}"
        Width="480" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0" Margin="20,20,20,8" MaxHeight="600" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="6">

                <!-- Language -->
                <TextBlock Text="{loc:Loc Language}" FontWeight="SemiBold" />
                <ComboBox Width="220" HorizontalAlignment="Left" Margin="0,4,0,0"
                          ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{loc:Loc Settings_LangRestart}" FontSize="12" Opacity="0.6"
                           TextWrapping="Wrap" Margin="0,4,0,0" />

                <Separator Margin="0,16,0,12" />

                <!-- Window buttons (minimize / close) -->
                <TextBlock Text="{loc:Loc Win_Section}" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Loc Win_Intro}" TextWrapping="Wrap" Opacity="0.7" FontSize="13" Margin="0,4,0,6" />
                <CheckBox Content="{loc:Loc Win_MinimizeToTray}" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                <CheckBox Content="{loc:Loc Win_CloseToTray}" IsChecked="{Binding CloseToTray, Mode=TwoWay}" />

                <Separator Margin="0,16,0,12" />

                <!-- Animaciones -->
                <TextBlock Text="{loc:Loc Motion_Section}" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Loc Motion_Intro}" TextWrapping="Wrap" Opacity="0.7" FontSize="13" Margin="0,4,0,6" />
                <CheckBox Content="{loc:Loc Motion_Enabled}" IsChecked="{Binding Animations, Mode=TwoWay}" />

                <Separator Margin="0,16,0,12" />

                <!-- Desktop shortcut -->
                <TextBlock Text="{loc:Loc Shortcut_Section}" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Loc Shortcut_Intro}" TextWrapping="Wrap" Opacity="0.7"
                           FontSize="13" Margin="0,4,0,6" />
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button x:Name="ShortcutBtn" Content="{loc:Loc Shortcut_Create}"
                            Click="CreateShortcut_Click" />
                    <TextBlock x:Name="ShortcutStatus" VerticalAlignment="Center" FontSize="12"
                               TextWrapping="Wrap" MaxWidth="320" />
                </StackPanel>

                <Separator Margin="0,16,0,12" />

                <!-- Notifications -->
                <TextBlock Text="{loc:Loc Notif_Section}" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Loc Notif_Intro}" TextWrapping="Wrap" Opacity="0.7" FontSize="13" Margin="0,4,0,6" />
                <CheckBox x:Name="NotifMaster" Content="{loc:Loc Notif_Enabled}"
                          IsChecked="{Binding Notifications.Enabled, Mode=TwoWay}" FontWeight="SemiBold" />
                <StackPanel Margin="24,4,0,0" Spacing="4" IsEnabled="{Binding #NotifMaster.IsChecked}">
                    <CheckBox Content="{loc:Loc Notif_Join}" IsChecked="{Binding Notifications.PlayerJoined, Mode=TwoWay}" />
                    <CheckBox Content="{loc:Loc Notif_Leave}" IsChecked="{Binding Notifications.PlayerLeft, Mode=TwoWay}" />
                    <CheckBox Content="{loc:Loc Notif_Death}" IsChecked="{Binding Notifications.PlayerDeath, Mode=TwoWay}" />
                    <CheckBox Content="{loc:Loc Notif_Crash}" IsChecked="{Binding Notifications.ServerCrashed, Mode=TwoWay}" />
                    <CheckBox Content="{loc:Loc Notif_OptGaveUp}" IsChecked="{Binding Notifications.AutoRestartGaveUp, Mode=TwoWay}" />
                    <CheckBox Content="{loc:Loc Notif_OptIdleStop}" IsChecked="{Binding Notifications.IdleShutdown, Mode=TwoWay}" />
                    <CheckBox Content="{loc:Loc Notif_OptWoke}" IsChecked="{Binding Notifications.WokeOnDemand, Mode=TwoWay}" />
                </StackPanel>

                <!-- Colours, one per level rather than one per kind. Seven boxes would be seven
                     decisions to make and seven ways to end up with a palette that means nothing;
                     four answer the only question a glance asks. Typed as hex with a live preview
                     beside it, and no colour-picker control: the app has no such dependency, and
                     hand-rolling a full picker to set four values would be a lot of surface for
                     something a pasted #RRGGBB does better. -->
                <TextBlock Text="{loc:Loc Notif_Colors}" FontWeight="SemiBold" Margin="0,14,0,0" />
                <TextBlock Text="{loc:Loc Notif_ColorsIntro}" TextWrapping="Wrap" Opacity="0.7"
                           FontSize="13" Margin="0,4,0,6" />

                <!-- La etiqueta en la columna elastica y con recorte, la muestra y la casilla
                     a la derecha en columnas Auto. Antes la etiqueta tenia 140 pixeles fijos y las
                     etiquetas largas se dibujaban encima de la muestra: un Grid no recorta a sus
                     hijos, asi que el texto simplemente se salia. Asi no puede volver a pasar ni
                     con la traduccion mas larga. -->
                <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
                      IsEnabled="{Binding #NotifMaster.IsChecked}" Margin="0,2,0,0">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Notif_LevelSuccess}"
                               ToolTip.Tip="{loc:Loc Notif_LevelSuccessTip}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,3,12,3" />
                    <Border Grid.Row="0" Grid.Column="1" Width="26" Height="20" CornerRadius="3" Margin="0,3,8,3"
                            Background="{Binding Notifications.ColorSuccess, Converter={x:Static vm:HexBrushConverter.Instance}}" />
                    <TextBox Grid.Row="0" Grid.Column="2" x:Name="ColorSuccessBox" Width="110" Margin="0,3"
                             Text="{Binding Notifications.ColorSuccess, Mode=TwoWay}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Notif_LevelInfo}"
                               ToolTip.Tip="{loc:Loc Notif_LevelInfoTip}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,3,12,3" />
                    <Border Grid.Row="1" Grid.Column="1" Width="26" Height="20" CornerRadius="3" Margin="0,3,8,3"
                            Background="{Binding Notifications.ColorInfo, Converter={x:Static vm:HexBrushConverter.Instance}}" />
                    <TextBox Grid.Row="1" Grid.Column="2" x:Name="ColorInfoBox" Width="110" Margin="0,3"
                             Text="{Binding Notifications.ColorInfo, Mode=TwoWay}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc Notif_LevelWarning}"
                               ToolTip.Tip="{loc:Loc Notif_LevelWarningTip}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,3,12,3" />
                    <Border Grid.Row="2" Grid.Column="1" Width="26" Height="20" CornerRadius="3" Margin="0,3,8,3"
                            Background="{Binding Notifications.ColorWarning, Converter={x:Static vm:HexBrushConverter.Instance}}" />
                    <TextBox Grid.Row="2" Grid.Column="2" x:Name="ColorWarningBox" Width="110" Margin="0,3"
                             Text="{Binding Notifications.ColorWarning, Mode=TwoWay}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc Notif_LevelError}"
                               ToolTip.Tip="{loc:Loc Notif_LevelErrorTip}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,3,12,3" />
                    <Border Grid.Row="3" Grid.Column="1" Width="26" Height="20" CornerRadius="3" Margin="0,3,8,3"
                            Background="{Binding Notifications.ColorError, Converter={x:Static vm:HexBrushConverter.Instance}}" />
                    <TextBox Grid.Row="3" Grid.Column="2" x:Name="ColorErrorBox" Width="110" Margin="0,3"
                             Text="{Binding Notifications.ColorError, Mode=TwoWay}" />
                </Grid>

                <TextBlock Text="{loc:Loc Console_Colors}" FontWeight="SemiBold" Margin="0,14,0,0" />
                <TextBlock Text="{loc:Loc Console_ColorsIntro}" TextWrapping="Wrap" Opacity="0.7"
                           FontSize="13" Margin="0,4,0,6" />
                <!-- La etiqueta en la columna elastica y con recorte, la muestra y la casilla
                     a la derecha en columnas Auto. Antes la etiqueta tenia 140 pixeles fijos y las
                     etiquetas largas se dibujaban encima de la muestra: un Grid no recorta a sus
                     hijos, asi que el texto simplemente se salia. Asi no puede volver a pasar ni
                     con la traduccion mas larga. -->
                <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto"
                      Margin="0,2,0,0">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc Console_ColorChat}"
                               ToolTip.Tip="{loc:Loc Console_ColorChatTip}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,3,12,3" />
                    <Border Grid.Row="0" Grid.Column="1" Width="26" Height="20" CornerRadius="3" Margin="0,3,8,3"
                            Background="{Binding ConsoleChatColor, Converter={x:Static vm:HexBrushConverter.Instance}}" />
                    <TextBox Grid.Row="0" Grid.Column="2" x:Name="ColorChatBox" Width="110" Margin="0,3"
                             Text="{Binding ConsoleChatColor, Mode=TwoWay}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc Console_ColorPlayers}"
                               ToolTip.Tip="{loc:Loc Console_ColorPlayersTip}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,3,12,3" />
                    <Border Grid.Row="1" Grid.Column="1" Width="26" Height="20" CornerRadius="3" Margin="0,3,8,3"
                            Background="{Binding ConsolePlayersColor, Converter={x:Static vm:HexBrushConverter.Instance}}" />
                    <TextBox Grid.Row="1" Grid.Column="2" x:Name="ColorPlayersBox" Width="110" Margin="0,3"
                             Text="{Binding ConsolePlayersColor, Mode=TwoWay}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                    <Button Content="{loc:Loc Notif_Test}" Click="TestNotification_Click"
                            ToolTip.Tip="{loc:Loc Notif_TestTip}" />
                    <Button Content="{loc:Loc Notif_ResetColors}" Click="ResetColors_Click"
                            ToolTip.Tip="{loc:Loc Notif_ResetColorsTip}" />
                </StackPanel>

                <Separator Margin="0,16,0,12" />

                <!-- Playit.gg connection -->
                <TextBlock Text="Playit.gg" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Loc Pk_SettingsDesc}" TextWrapping="Wrap" Opacity="0.7" FontSize="13" Margin="0,4,0,6" />
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Ellipse x:Name="PlayitDot" Width="10" Height="10" VerticalAlignment="Center" />
                    <TextBlock x:Name="PlayitStatus" VerticalAlignment="Center" />
                    <Button x:Name="ConnectBtn" Content="{loc:Loc Pk_Connect}" Click="ConnectPlayit_Click" />
                    <Button x:Name="DisconnectBtn" Content="{loc:Loc Pk_Disconnect}" Click="DisconnectPlayit_Click" />
                </StackPanel>
                <StackPanel x:Name="AgentRow" Spacing="6" Margin="0,8,0,0">
                    <SelectableTextBlock x:Name="AgentStatus" FontSize="12" TextWrapping="Wrap" MaxWidth="430"
                                         HorizontalAlignment="Left" />
                    <Button x:Name="AgentRetryBtn" Content="{loc:Loc Pk_Agent_Retry}" FontSize="12" Padding="8,2"
                            HorizontalAlignment="Left" Click="RetryAgent_Click" IsVisible="False" />
                </StackPanel>
                <TextBlock Text="{loc:Loc Pk_Disclaimer}" TextWrapping="Wrap" Opacity="0.55" FontSize="11" Margin="0,8,0,0" />

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,12,20,16" Spacing="8">
            <Button Content="{loc:Loc Cancel}" Click="Cancel_Click" />
            <Button Classes="accent" Content="{loc:Loc Save}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
