<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:McServerLauncher.Localization"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="McServerLauncher.Views.ServerSettings.StorageSection"
             x:CompileBindings="False">

    <!-- What the server's folder takes on disk, and of what. DataContext: the ServerViewModel, not the
         draft: nothing here is a setting, so nothing here is ever unsaved. -->
    <UserControl.Styles>
        <Style Selector="Border.swatch">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style Selector="TextBlock.size">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>
        <Style Selector="TextBlock.pct">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </UserControl.Styles>

    <Border Classes="card">
        <StackPanel>
            <DockPanel Classes="setting">
                <StackPanel Classes="ctl" Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding MeasureDiskCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:FluentIcon Icon="ArrowClockwise" />
                            <TextBlock Text="{loc:Loc Disk_Measure}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenFolderButton" Click="OpenFolder_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:FluentIcon Icon="FolderOpen" />
                            <TextBlock Text="{loc:Loc Disk_OpenFolder}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding DiskTotalText}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DiskMeasuredText}" Classes="desc" />
                    <TextBlock Text="{Binding Config.FolderPath}" Classes="desc" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Config.FolderPath}" />
                </StackPanel>
            </DockPanel>

            <StackPanel IsVisible="{Binding HasDiskUsage}" Margin="0,12,0,0">
                <!-- One bar, a piece per part, each as wide as its share: filled from the code. -->
                <Border Height="10" CornerRadius="5" ClipToBounds="True" Background="{StaticResource SurfaceChip}">
                    <Grid x:Name="Bar" />
                </Border>

                <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      Margin="0,10,0,0" RowSpacing="6">
                    <Border Grid.Row="0" Classes="swatch" Background="{StaticResource SemanticOk}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Loc Disk_WorldLong}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Classes="size" Text="{Binding DiskWorldText}" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Classes="pct" Text="{Binding DiskWorldPercent}" />

                    <Border Grid.Row="1" Classes="swatch" Background="{StaticResource SemanticInfo}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiskBackupsLabel}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Classes="size" Text="{Binding DiskBackupsText}" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Classes="pct" Text="{Binding DiskBackupsPercent}" />

                    <Border Grid.Row="2" Classes="swatch" Background="{StaticResource SemanticWarn}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DiskContentLabel}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Classes="size" Text="{Binding DiskContentText}" />
                    <TextBlock Grid.Row="2" Grid.Column="3" Classes="pct" Text="{Binding DiskContentPercent}" />

                    <Border Grid.Row="3" Classes="swatch" Background="{StaticResource SemanticDanger}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{loc:Loc Disk_LogsLong}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Classes="size" Text="{Binding DiskLogsText}" />
                    <TextBlock Grid.Row="3" Grid.Column="3" Classes="pct" Text="{Binding DiskLogsPercent}" />

                    <Border Grid.Row="4" Classes="swatch" Background="{StaticResource McListText}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{loc:Loc Disk_OtherLong}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Classes="size" Text="{Binding DiskOtherText}" />
                    <TextBlock Grid.Row="4" Grid.Column="3" Classes="pct" Text="{Binding DiskOtherPercent}" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
