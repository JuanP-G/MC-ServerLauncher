<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:McServerLauncher.Localization"
        xmlns:models="using:McServerLauncher.Models"
        x:Class="McServerLauncher.Views.AddEditServerDialog"
        x:DataType="models:ServerConfig"
        Title="{loc:Loc Cfg_Title}"
        Width="620" Height="640" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0" Margin="20,20,20,8" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{loc:Loc Cs_Name}" Margin="0,4" />
                <TextBox Text="{Binding Name, Mode=TwoWay}" />

                <TextBlock Text="{loc:Loc Ae_Folder}" Margin="0,12,0,4" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding FolderPath, Mode=TwoWay}" />
                    <Button Grid.Column="1" Content="{loc:Loc Browse}" Margin="8,0,0,0" Click="BrowseFolder_Click" />
                </Grid>

                <TextBlock Text="{loc:Loc Ae_Jar}" Margin="0,12,0,4" />
                <TextBox Text="{Binding JarFile, Mode=TwoWay}" />

                <TextBlock Text="{loc:Loc Ae_Java}" Margin="0,12,0,4" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding JavaPath, Mode=TwoWay}"
                             Watermark="{loc:Loc Ae_JavaPlaceholder}" />
                    <Button Grid.Column="1" Content="{loc:Loc Browse}" Margin="8,0,0,0" Click="BrowseJava_Click" />
                </Grid>

                <Grid ColumnDefinitions="*,*" Margin="0,12,0,0">
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="{loc:Loc Cs_RamMin}" Margin="0,0,0,4" />
                        <NumericUpDown Value="{Binding MinRamGb}" Minimum="1" Maximum="64" Increment="1" FormatString="0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="{loc:Loc Cs_RamMax}" Margin="0,0,0,4" />
                        <NumericUpDown Value="{Binding MaxRamGb}" Minimum="1" Maximum="64" Increment="1" FormatString="0" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{loc:Loc Ae_ExtraArgs}" Margin="0,12,0,4" />
                <TextBox Text="{Binding ExtraJvmArgs, Mode=TwoWay}" Watermark="e.g. -XX:+UseG1GC" />

                <Separator Margin="0,18,0,12" />

                <TextBlock Text="{loc:Loc Loader_Section}" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap">
                        <Run Text="{loc:Loc Loader_Current}" />
                        <Run Text="{Binding Type}" FontWeight="SemiBold" />
                        <Run Text="{Binding GameVersion}" />
                    </TextBlock>
                    <Button Grid.Column="1" Content="{loc:Loc Loader_ChangeButton}" Click="InstallLoader_Click" />
                </Grid>

                <Separator Margin="0,18,0,12" />

                <CheckBox Content="{loc:Loc Cs_UsePlayit}" IsChecked="{Binding PlayitEnabled, Mode=TwoWay}" />

                <Separator Margin="0,18,0,12" />

                <CheckBox x:Name="CrossplayCheck" Content="{loc:Loc Crossplay_Check}"
                          IsChecked="{Binding CrossplayEnabled, Mode=TwoWay}" />
                <TextBlock x:Name="CrossplayHint" Margin="24,4,0,0" FontSize="12" Opacity="0.6"
                           TextWrapping="Wrap" Text="{loc:Loc Crossplay_Hint}" />
                <TextBlock x:Name="CrossplayWhyNot" Margin="24,4,0,0" FontSize="12" Opacity="0.75"
                           TextWrapping="Wrap" IsVisible="False" Foreground="#E3A82B" />
                <!-- Shown on the mod loaders only, and with different text for each: on Fabric the
                     content checkbox below is the answer, on NeoForge there is none. The text comes
                     from CrossplayService.CaveatKey so both dialogs say the same thing. -->
                <TextBlock x:Name="CrossplayModdedNote" Margin="24,4,0,0" FontSize="12" Opacity="0.75"
                           TextWrapping="Wrap" IsVisible="False" Foreground="#E3A82B" />

                <CheckBox x:Name="MultiVersionCheck" Margin="0,10,0,0"
                          Content="{loc:Loc MultiVersion_Check}"
                          IsChecked="{Binding MultiVersionEnabled, Mode=TwoWay}" />
                <TextBlock x:Name="MultiVersionHint" Margin="24,4,0,0" FontSize="12" Opacity="0.6"
                           TextWrapping="Wrap" Text="{loc:Loc MultiVersion_Hint}" />
                <TextBlock x:Name="MultiVersionWhyNot" Margin="24,4,0,0" FontSize="12" Opacity="0.75"
                           TextWrapping="Wrap" IsVisible="False" Foreground="#E3A82B"
                           Text="{loc:Loc MultiVersion_Unsupported}" />

                <CheckBox x:Name="HydraulicCheck" Margin="0,10,0,0"
                          Content="{loc:Loc Hydraulic_Check}"
                          IsChecked="{Binding BedrockModContentEnabled, Mode=TwoWay}" />
                <TextBlock x:Name="HydraulicHint" Margin="24,4,0,0" FontSize="12" Opacity="0.6"
                           TextWrapping="Wrap" Text="{loc:Loc Hydraulic_Hint}" />
                <TextBlock x:Name="HydraulicWhyNot" Margin="24,4,0,0" FontSize="12" Opacity="0.75"
                           TextWrapping="Wrap" IsVisible="False" Foreground="#E3A82B"
                           Text="{loc:Loc Hydraulic_Unsupported}" />

                <Separator Margin="0,18,0,12" />

                <TextBlock Text="{loc:Loc Idle_Section}" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Loc Idle_Intro}" TextWrapping="Wrap" Opacity="0.7"
                           FontSize="13" Margin="0,4,0,8" />
                <CheckBox Content="{loc:Loc Wake_EnabledCheck}" Margin="0,0,0,4"
                          IsChecked="{Binding WakeOnDemand, Mode=TwoWay}" />
                <TextBlock Text="{loc:Loc Wake_Hint}" TextWrapping="Wrap" Opacity="0.55"
                           FontSize="12" Margin="24,0,0,10" />
                <Grid ColumnDefinitions="Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{loc:Loc Idle_MinutesLabel}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <NumericUpDown Grid.Column="1" Width="120" Value="{Binding IdleShutdownMinutes}"
                                   Minimum="0" Maximum="1440" Increment="5" FormatString="0" />
                </Grid>
                <TextBlock Text="{loc:Loc Idle_Hint}" TextWrapping="Wrap" Opacity="0.55"
                           FontSize="12" Margin="0,6,0,0" />

                <Separator Margin="0,18,0,12" />

                <TextBlock Text="{loc:Loc Backup_Section}" FontWeight="SemiBold" />
                <CheckBox Margin="0,8,0,0" Content="{loc:Loc Backup_EnabledCheck}"
                          IsChecked="{Binding BackupsEnabled, Mode=TwoWay}" />
                <Grid ColumnDefinitions="Auto,Auto" Margin="0,10,0,0" IsEnabled="{Binding BackupsEnabled}">
                    <TextBlock Grid.Column="0" Text="{loc:Loc Backup_RetentionLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <NumericUpDown Grid.Column="1" Width="120" Value="{Binding BackupRetention}"
                                   Minimum="1" Maximum="50" Increment="1" FormatString="0" />
                </Grid>

                <Separator Margin="0,18,0,12" />

                <TextBlock Text="{loc:Loc Notif_Section}" FontWeight="SemiBold" />
                <CheckBox x:Name="UseCustomNotifCheck" Margin="0,8,0,0" Content="{loc:Loc Notif_UseCustom}"
                          IsChecked="{Binding UseCustomNotifications, Mode=TwoWay}" />
                <StackPanel Margin="24,6,0,0" Spacing="4" IsEnabled="{Binding #UseCustomNotifCheck.IsChecked}">
                    <CheckBox x:Name="NotifEnabledCheck" Content="{loc:Loc Notif_Enabled}"
                              IsChecked="{Binding Notifications.Enabled, Mode=TwoWay}" FontWeight="SemiBold" />
                    <StackPanel Margin="24,2,0,0" Spacing="4" IsEnabled="{Binding #NotifEnabledCheck.IsChecked}">
                        <CheckBox Content="{loc:Loc Notif_Join}" IsChecked="{Binding Notifications.PlayerJoined, Mode=TwoWay}" />
                        <CheckBox Content="{loc:Loc Notif_Leave}" IsChecked="{Binding Notifications.PlayerLeft, Mode=TwoWay}" />
                        <CheckBox Content="{loc:Loc Notif_Death}" IsChecked="{Binding Notifications.PlayerDeath, Mode=TwoWay}" />
                        <CheckBox Content="{loc:Loc Notif_Crash}" IsChecked="{Binding Notifications.ServerCrashed, Mode=TwoWay}" />
                        <CheckBox Content="{loc:Loc Notif_OptGaveUp}" IsChecked="{Binding Notifications.AutoRestartGaveUp, Mode=TwoWay}" />
                        <CheckBox Content="{loc:Loc Notif_OptIdleStop}" IsChecked="{Binding Notifications.IdleShutdown, Mode=TwoWay}" />
                        <CheckBox Content="{loc:Loc Notif_OptWoke}" IsChecked="{Binding Notifications.WokeOnDemand, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,8,20,16" Spacing="8">
            <Button Content="{loc:Loc Cancel}" Click="Cancel_Click" />
            <Button Classes="accent" Content="{loc:Loc Save}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
