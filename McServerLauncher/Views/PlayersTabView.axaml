<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:McServerLauncher.ViewModels"
             xmlns:views="using:McServerLauncher.Views"
             xmlns:loc="using:McServerLauncher.Localization"
             xmlns:ic="using:FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="McServerLauncher.Views.PlayersTabView"
             x:DataType="vm:ServerViewModel"
             x:CompileBindings="False">

    <Panel>
        <!-- A player's profile replaces the lists while it is open, the way a mod's
             page replaces the store in the Mods tab. -->
        <ContentControl Content="{Binding History.Details}" IsVisible="{Binding History.HasDetails}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:PlayerDetailsViewModel">
                    <views:PlayerDetailsView />
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
        <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" IsVisible="{Binding !History.HasDetails}">
            <StackPanel>
                <Grid Margin="4,0,4,8">
                    <TextBlock Text="{loc:Loc Players_Manage}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" Padding="8,2" Command="{Binding RefreshPlayersCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="ArrowClockwise" />
                            <TextBlock Text="{loc:Loc Refresh}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Connected -->
                <Border Classes="card stat">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontWeight="SemiBold" Text="{loc:Loc Players_Connected}" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding ConnectedPlayers.Count, StringFormat=' ({0})'}" />
                        </StackPanel>
                        <TextBlock Classes="statLabel" Text="{loc:Loc Players_ConnectedHint}" />
                        <ItemsControl ItemsSource="{Binding ConnectedPlayers}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3" ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button Content="OP" Padding="8,2"
                                                    Command="{Binding DataContext.OpPlayerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="{loc:Loc Kick}" Padding="8,2"
                                                    Command="{Binding DataContext.KickPlayerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="{loc:Loc Ban}" Padding="8,2" Background="{StaticResource DangerButton}" Foreground="White"
                                                    Command="{Binding DataContext.BanPlayerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Everyone who has been on the server: last seen, and a click for the profile -->
                <Border Classes="card stat">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontWeight="SemiBold" Text="{loc:Loc History_Players}" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding History.Rows.Count, StringFormat=' ({0})'}" />
                        </StackPanel>
                        <TextBlock Classes="statLabel" TextWrapping="Wrap" Text="{loc:Loc History_PlayersHint}" />
                        <TextBlock Classes="statLabel" TextWrapping="Wrap" Text="{loc:Loc History_Importing}"
                                   IsVisible="{Binding History.IsImporting}" />
                        <TextBlock Classes="statLabel" TextWrapping="Wrap" Text="{loc:Loc History_DisabledHint}"
                                   Foreground="{StaticResource SemanticWarn}" IsVisible="{Binding History.IsDisabled}" />
                        <TextBox Margin="0,8,0,4" Text="{Binding History.Search}" Watermark="{loc:Loc History_Search}" />
                        <ItemsControl ItemsSource="{Binding History.Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Background="Transparent" Padding="6,5" Margin="0,1"
                                            ToolTip.Tip="{Binding LastSeenTip}"
                                            Command="{Binding DataContext.History.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="16,*,Auto,Auto">
                                            <Ellipse Grid.Column="0" Width="8" Height="8" HorizontalAlignment="Left"
                                                     Fill="{StaticResource SemanticOk}" IsVisible="{Binding IsOnline}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding LastSeenText}" Opacity="0.7"
                                                       VerticalAlignment="Center" Margin="12,0,8,0" />
                                            <ic:SymbolIcon Grid.Column="3" Symbol="ChevronRight" Opacity="0.5" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Operators -->
                <Border Classes="card stat">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontWeight="SemiBold" Text="{loc:Loc Players_Ops}" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding OpPlayers.Count, StringFormat=' ({0})'}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding OpPlayers}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3" ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="{loc:Loc RemoveOp}" Padding="8,2"
                                                Command="{Binding DataContext.DeopPlayerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Whitelist -->
                <Border Classes="card stat">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontWeight="SemiBold" Text="{loc:Loc Players_Whitelist}" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding WhitelistPlayers.Count, StringFormat=' ({0})'}" />
                        </StackPanel>
                        <TextBlock Classes="statLabel" Text="{loc:Loc Whitelist_Hint}" />
                        <Grid Margin="0,8,0,8" ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Margin="0,0,8,0" Text="{Binding NewWhitelistName}"
                                     Watermark="{loc:Loc Player_Placeholder}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding AddToWhitelistCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Grid.Column="1" Classes="accent" Command="{Binding AddToWhitelistCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:SymbolIcon Symbol="PersonAdd" />
                                    <TextBlock Text="{loc:Loc Add}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding WhitelistPlayers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3" ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="{loc:Loc Remove}" Padding="8,2"
                                                Command="{Binding DataContext.RemoveFromWhitelistCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Banned -->
                <Border Classes="card stat">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontWeight="SemiBold" Text="{loc:Loc Players_Banned}" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding BannedPlayers.Count, StringFormat=' ({0})'}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding BannedPlayers}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3" ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="{loc:Loc Unban}" Padding="8,2"
                                                Command="{Binding DataContext.PardonPlayerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Panel>

</UserControl>
