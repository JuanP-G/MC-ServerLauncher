<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:McServerLauncher.Localization"
             x:Class="McServerLauncher.Views.ServerTypePicker">
    <UserControl.Resources>
        <!-- A RadioButton drawn as a card instead of a bullet and a label. The control underneath
             is still a RadioButton, so single selection, keyboard navigation and screen readers
             keep working; only the appearance changes. Colours come from the code-behind, which
             gives each card its own type's accent when picked. -->
        <ControlTheme x:Key="TypeCardTheme" TargetType="RadioButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="CardRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          VerticalAlignment="Top"
                                          HorizontalAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:pointerover /template/ Border#CardRoot">
                <Setter Property="Opacity" Value="0.85" />
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <!-- The cards themselves are built in code from ServerTypeCatalog rather than written out
         here. The old picker listed every type twice in XAML, once per dialog, and a type added to
         one and forgotten in the other was a silent bug: its Tag no longer matched and the choice
         fell back to Vanilla. There is now one list, and it is the table. -->
    <StackPanel>
        <TextBlock x:Name="GroupHeader" Text="{loc:Loc Cs_TypeGroupJava}"
                   FontWeight="SemiBold" FontSize="13" Opacity="0.7" Margin="0,0,0,6" />
        <WrapPanel x:Name="CardsPanel" Orientation="Horizontal" />
    </StackPanel>
</UserControl>
