<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Cross-platform: Avalonia runs on Windows, Linux and macOS (no more net9.0-windows/WPF). -->
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>McServerLauncher</RootNamespace>
    <AssemblyName>McServerLauncher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>1.15.0</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Generate the XML documentation file from /// comments (consumed by DocFX). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Don't require docs on every public member (avoids CS1591 noise); we document what matters. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Languages we ship (ours). Avoids pulling in every language of the libraries. -->
    <SatelliteResourceLanguages>en;pt;fr;de</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Resources\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The decision logic worth testing is internal on purpose: it is implementation, not API.
         Handing it to the test project lets the tests call those members directly, so renaming one
         breaks the build instead of failing at run time the way reflection would. -->
    <InternalsVisibleTo Include="McServerLauncher.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Store data read at runtime: the tag catalogue and the plain-language summaries. Both are
         data, not code, and both can be overridden by a file of the same name in the user's data
         folder (see StoreTagService / StoreSummaryService). -->
    <EmbeddedResource Include="Resources\store-tags.json" />
    <EmbeddedResource Include="Resources\store-summaries.json" />

    <!-- The install scripts the modpack carries. Shape here, wording in the .resx files: a couple
         of hundred lines of shell inside a resx <value> would be escaped XML, unreviewable in a diff, and
         subject to the translation-parity checks on logic that must be identical in every
         language. See InstallScriptBuilder.

         WithCulture=false is not optional here, and the reason is worth writing down: MSBuild
         infers a culture from the dotted segments of a resource's file name, and "sh" is a real
         culture code (Serbo-Croatian). Left to itself it decided install-mods-unix.sh.in was a
         translation, routed it to a satellite assembly and left it out of the main one — so the
         template was simply missing at run time while the build stayed green. LogicalName pins the
         name the code looks up, instead of letting it be derived from the path. -->
    <EmbeddedResource Include="Resources\scripts\install-mods-windows.bat.in">
      <WithCulture>false</WithCulture>
      <LogicalName>McServerLauncher.Resources.scripts.install-mods-windows.bat.in</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\scripts\install-mods-unix.sh.in">
      <WithCulture>false</WithCulture>
      <LogicalName>McServerLauncher.Resources.scripts.install-mods-unix.sh.in</LogicalName>
    </EmbeddedResource>
  </ItemGroup>


  <ItemGroup>
    <!-- Cross-platform reference: compiles everywhere, only used at runtime on Windows (guarded with
         OperatingSystem.IsWindows()). On Linux Playit is managed via systemctl instead. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.0" />
    <!-- DPAPI to store the Playit API key encrypted at rest. Windows-only at runtime (guarded with
         OperatingSystem.IsWindows()); on Linux/macOS the key is kept as-is. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.2.3" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="FluentIcons.Avalonia" Version="1.1.265" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

</Project>
